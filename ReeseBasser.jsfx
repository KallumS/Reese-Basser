  i == 72 ? slider_automate(width, done) :
  i == 73 ? slider_automate(monobass, done) :
  i == 74 ? slider_automate(vmode, done) :
  i == 75 ? slider_automate(glide, done) :
  i == 76 ? slider_automate(glidemode, done) :
  i == 77 ? slider_automate(bendr, done) :
  i == 78 ? slider_automate(velsens, done) :
  i == 79 ? slider_automate(octave, done) :
  i == 80 ? slider_automate(quality, done) :
  i == 81 ? slider_automate(volume, done) :
  i == 82 ? slider_automate(limiter, done) :
  i == 83 ? slider_automate(m1src, done) :
  i == 84 ? slider_automate(m1dst, done) :
  i == 85 ? slider_automate(m1amt, done) :
  i == 86 ? slider_automate(m2src, done) :
  i == 87 ? slider_automate(m2dst, done) :
  i == 88 ? slider_automate(m2amt, done) :
