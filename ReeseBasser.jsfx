  i == 94 ? sliderchange(m4amt) :
  i == 95 ? sliderchange(m5src) :
  i == 96 ? sliderchange(m5dst) :
  i == 97 ? sliderchange(m5amt) :
  i == 98 ? sliderchange(m6src) :
  i == 99 ? sliderchange(m6dst) :
  i == 100 ? sliderchange(m6amt) :
  0;
);
function automate(i, done) (
  i == 1 ? slider_automate(eng, done) :
  i == 2 ? slider_automate(det, done) :
  i == 3 ? slider_automate(detmode, done) :
  i == 4 ? slider_automate(beathz, done) :
  i == 5 ? slider_automate(beatdiv, done) :
  i == 6 ? slider_automate(enga, done) :
