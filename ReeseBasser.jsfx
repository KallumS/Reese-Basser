  i == 96 ? slider_automate(m5dst, done) :
  i == 97 ? slider_automate(m5amt, done) :
  i == 98 ? slider_automate(m6src, done) :
  i == 99 ? slider_automate(m6dst, done) :
  i == 100 ? slider_automate(m6amt, done) :
  0;
);
// set a parameter from the UI (records automation)
function p_set(i, v) (
  v = clamp(v, PMIN[i], PMAX[i]);
  PSTEP[i] ? v = floor(v + 0.5);
  slider(i) != v ? (
    slider(i) = v;
    automate(i, 0);
    ui_dirty = 1; preset_edited = 1;
  );
);
// set a parameter without automation (presets / mutate)
function p_put(i, v) (
  v = clamp(v, PMIN[i], PMAX[i]);
  PSTEP[i] ? v = floor(v + 0.5);
  slider(i) = v;
  notify(i);
  ui_dirty = 1;
);
function engine_defaults() (
  p_set(6, ENGDEF[eng*3]); p_set(7, ENGDEF[eng*3 + 1]); p_set(8, ENGDEF[eng*3 + 2]);
  PDEF[6] = ENGDEF[eng*3]; PDEF[7] = ENGDEF[eng*3 + 1]; PDEF[8] = ENGDEF[eng*3 + 2];
);
// copy the n-th item of a '|' separated list into dest
function list_item(dest, list, n) local(i, c, start, k) (
  i = 0; k = 0; start = 0;
  while ((c = str_getchar(list, i)) > 0 && k <= n) (
    c == 124 ? ( k == n ? k = n + 1 : ( k += 1; start = i + 1; ); );
    i += 1;
  );
  k > n ? i -= 1;
  strcpy_substr(dest, list, start, i - start);
  dest;
);
// build a popup menu string with the current item checked
function build_menu(dest, list, cur) local(i, n) (
  strcpy(dest, "");
  n = enum_count(list); i = 0;
  loop(n,
    i > 0 ? strcat(dest, "|");
    i == cur ? strcat(dest, "!");
    strcat(dest, list_item(#mtmp, list, i));
    i += 1;
  );
  dest;
);
function fmt_hz(dest, v) (
  abs(v) >= 1000 ? sprintf(dest, "%.2f kHz", v/1000) :
  abs(v) >= 100 ? sprintf(dest, "%.0f Hz", v) :
  abs(v) >= 10 ? sprintf(dest, "%.1f Hz", v) : sprintf(dest, "%.2f Hz", v);
);
function fmt_ms(dest, v) (
  v >= 1000 ? sprintf(dest, "%.2f s", v/1000) : v >= 100 ? sprintf(dest, "%.0f ms", v) : sprintf(dest, "%.1f ms", v);
);
// human readable value of parameter i into dest
function fmt_val(dest, i) local(v, u, e, n) (
  v = slider(i); u = PUNIT[i];
  (i >= 6 && i <= 8) ? (
    e = eng; n = v*0.01;
    e == 0 && i == 6 ? (
      n < 0.02 ? strcpy(dest, "Saw") : abs(n - 0.3333) < 0.02 ? strcpy(dest, "Square") :
      abs(n - 0.6667) < 0.02 ? strcpy(dest, "Triangle") : n > 0.98 ? strcpy(dest, "Sine") : sprintf(dest, "%.0f%%", v);
    ) :
    e == 0 && i == 7 ? sprintf(dest, INTV[floor(n*7.999)] > 0 ? "+%d st" : "%d st", INTV[floor(n*7.999)]) :
    e == 1 && i == 6 ? sprintf(dest, "%d voices", 3 + floor(v*0.13 + 0.5)) :
    e == 3 && i == 7 ? list_item(dest, CZWAVES, floor(n*5.999)) :
    e == 4 && i == 7 ? sprintf(dest, "ratio %.1f", FMR[floor(n*5.999)]) :
    e == 5 && i == 6 ? sprintf(dest, "x%.2f", 1 + n*7) :
    e == 6 && i == 8 ? sprintf(dest, "%d stages", 2*(1 + floor(n*5.999))) :
    sprintf(dest, "%.0f%%", v);
  ) :
  u == 10 ? list_item(dest, PENUM[i], v) :
  u == 1 ? ( (i == 20 || i == 73) && v < 0.5 ? strcpy(dest, "Off") : fmt_hz(dest, v); ) :
  u == 2 ? fmt_ms(dest, v) :
  u == 3 ? sprintf(dest, "%.0f%%", v) :
  u == 4 ? sprintf(dest, "%.1f ct", v) :
  u == 5 ? sprintf(dest, v > 0 ? "+%.1f dB" : "%.1f dB", v) :
  u == 6 ? sprintf(dest, "%d", v) :
  u == 7 ? sprintf(dest, "x%.2f", v) :
  u == 8 ? sprintf(dest, "%d st", v) :
  u == 9 ? sprintf(dest, v > 0.5 ? "+%.0f%%" : "%.0f%%", v) :
  u == 11 ? sprintf(dest, v > 0 ? "+%d oct" : "%d oct", v) :
  i == 65 ? ( v > 15.95 ? strcpy(dest, "Off") : sprintf(dest, "%.1f bit", v); ) :
  sprintf(dest, "%.1f", v);
  dest;
);

// ---------------------------------------------------------------- drawing (logical coords)
function col(r, g, b, a) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; );
function RF(x, y, w, h) ( gfx_rect(ui_ox + x*ui_s, ui_oy + y*ui_s, max(1, w*ui_s), max(1, h*ui_s)); );
function RO(x, y, w, h) local(x0, y0, x1, y1) (
  x0 = floor(ui_ox + x*ui_s); y0 = floor(ui_oy + y*ui_s);
  x1 = floor(ui_ox + (x + w)*ui_s) - 1; y1 = floor(ui_oy + (y + h)*ui_s) - 1;
  gfx_rect(x0, y0, x1 - x0 + 1, 1); gfx_rect(x0, y1, x1 - x0 + 1, 1);
  gfx_rect(x0, y0, 1, y1 - y0 + 1); gfx_rect(x1, y0, 1, y1 - y0 + 1);
);
function LN(x1, y1, x2, y2) ( gfx_line(ui_ox + x1*ui_s, ui_oy + y1*ui_s, ui_ox + x2*ui_s, ui_oy + y2*ui_s, 1); );
function CI(x, y, r, f) ( gfx_circle(ui_ox + x*ui_s, ui_oy + y*ui_s, r*ui_s, f, 1); );
function ARC(x, y, r, a0, a1) ( gfx_arc(ui_ox + x*ui_s, ui_oy + y*ui_s, r*ui_s, a0, a1, 1); );
// text in a box; flags: 1 = center h, 2 = right, 4 = center v
function TX(str, x, y, w, h, flags) (
  // gfx_drawstr clips to (gfx_x, gfx_y, right, bottom): pad the box so glyphs are never cut
  flags & 4 ? ( y -= 4; h += 8; ) : h += 5;
  gfx_x = ui_ox + x*ui_s; gfx_y = ui_oy + y*ui_s;
  gfx_drawstr(str, flags, ui_ox + (x + w)*ui_s, ui_oy + (y + h)*ui_s);
);
function font(n) ( gfx_setfont(n); );
function setup_fonts(s) (
  gfx_setfont(1, "Arial", max(8, 12*s));
  gfx_setfont(2, "Arial", max(8, 11.5*s));
  gfx_setfont(3, "Arial", max(8, 13*s), 98);
  gfx_setfont(4, "Arial", max(10, 27*s), 98);
  gfx_setfont(5, "Arial", max(8, 13*s));
  gfx_setfont(6, "Arial", max(8, 11*s));
);
function inr(x, y, w, h) ( ui_mx >= x && ui_mx < x + w && ui_my >= y && ui_my < y + h; );
function accent(r, g, b) ( acr = r; acg = g; acb = b; );
function panel(x, y, w, h, title) (
  col(0.105, 0.115, 0.14, 1); RF(x, y, w, h);
  col(acr, acg, acb, 0.9); RF(x, y, w, 2);
  col(0.2, 0.22, 0.26, 1); RO(x, y, w, h);
  font(3); col(acr, acg, acb, 1); TX(title, x + 10, y + 8, w - 20, 16, 0);
);
function small_caption(str, x, y, w) (
  font(6); col(0.5, 0.53, 0.6, 1); TX(str, x, y, w, 12, 1);
  col(0.28, 0.3, 0.35, 1); LN(x + 4, y + 14, x + w - 4, y + 14);
);

// ---------------------------------------------------------------- mouse bookkeeping
function begin_widget(i, hit) (
  hit ? ( ui_hov = i; );
  ui_click && hit && ui_drag == 0 ? (
    // double click or ctrl/cmd click: reset to default
    (ui_now - ui_last_click_t < 0.35 && ui_last_click_i == i) || (mouse_cap & 4) ? (
      p_set(i, PDEF[i]); ui_drag = -1;
    ) : (
      ui_drag = i; ui_drag_y = ui_my; ui_drag_x = ui_mx; ui_drag_n = norm_of(i, slider(i));
    );
    ui_last_click_t = ui_now; ui_last_click_i = i;
  );
);
function wheel_widget(i, hit) (
  hit && mouse_wheel != 0 && ui_drag == 0 ? (
    PSTEP[i] ? p_set(i, slider(i) + (mouse_wheel > 0 ? 1 : -1)*(PENUM[i] ? -1 : 1)) :
               p_set(i, val_of(i, norm_of(i, slider(i)) + mouse_wheel/120*((mouse_cap & 8) ? 0.002 : 0.02)));
    mouse_wheel = 0;
  );
);

// ---------------------------------------------------------------- widgets
// rotary knob, cell 66 x 74
function knob(i, x, y, lbl) local(cx, cy, n, a0, a1, ac, hit, bip, px, py, r, sens) (
  cx = x + 33; cy = y + 22; r = 19;
  hit = inr(x + 5, y, 56, 72);
  begin_widget(i, hit);
  wheel_widget(i, hit);
  ui_drag == i ? (
    sens = (mouse_cap & 8) ? 0.0006 : 0.005;
    PSTEP[i] && PMAX[i] - PMIN[i] < 40 ? sens = 1/(PMAX[i] - PMIN[i] + 1)/14;
    p_set(i, val_of(i, ui_drag_n + (ui_drag_y - ui_my)*sens));
  );
  n = clamp(norm_of(i, slider(i)), 0, 1);
  bip = PMIN[i] < 0 && PMAX[i] > 0 && PUNIT[i] != 5;
  a0 = -0.75*$pi; a1 = 0.75*$pi;
  // track
  col(0.2, 0.22, 0.26, 1);
  ARC(cx, cy, r, a0, a1); ARC(cx, cy, r - 1, a0, a1); ARC(cx, cy, r - 2, a0, a1);
  // value arc
  ac = a0 + (a1 - a0)*n;
  col(acr, acg, acb, hit || ui_drag == i ? 1 : 0.85);
  bip ? (
    ac < 0 ? ( ARC(cx, cy, r, ac, 0); ARC(cx, cy, r - 1, ac, 0); ARC(cx, cy, r - 2, ac, 0); ) :
             ( ARC(cx, cy, r, 0, ac); ARC(cx, cy, r - 1, 0, ac); ARC(cx, cy, r - 2, 0, ac); );
  ) : n > 0.002 ? ( ARC(cx, cy, r, a0, ac); ARC(cx, cy, r - 1, a0, ac); ARC(cx, cy, r - 2, a0, ac); );
  // cap and pointer
  col(0.15, 0.165, 0.2, 1); CI(cx, cy, r - 5, 1);
  col(0.3, 0.33, 0.38, 1); CI(cx, cy, r - 5, 0);
  px = cx + sin(ac)*(r - 6); py = cy - cos(ac)*(r - 6);
  col(0.92, 0.94, 0.97, 1); LN(cx + sin(ac)*(r - 13), cy - cos(ac)*(r - 13), px, py);
  // labels
  font(6); col(0.66, 0.69, 0.76, 1); TX(lbl, x - 4, y + 45, 74, 12, 1);
  font(2);
  hit || ui_drag == i ? col(1, 1, 1, 1) : col(acr*0.5 + 0.4, acg*0.5 + 0.4, acb*0.5 + 0.4, 1);
  TX(fmt_val(#kv, i), x - 6, y + 59, 78, 13, 1);
);
// dropdown box
function dropdown(i, x, y, w, h) local(hit, old) (
  old = slider(i);
  hit = inr(x, y, w, h);
  hit ? ui_hov = i;
  col(0.07, 0.075, 0.09, 1); RF(x, y, w, h);
  col(hit ? acr : 0.3, hit ? acg : 0.33, hit ? acb : 0.38, 1); RO(x, y, w, h);
  font(5); col(0.9, 0.92, 0.95, 1);
  TX(list_item(#dd, PENUM[i], slider(i)), x + 6, y, w - 20, h, 4);
  col(acr, acg, acb, 1);
  gfx_triangle(ui_ox + (x + w - 13)*ui_s, ui_oy + (y + h*0.5 - 2)*ui_s, ui_ox + (x + w - 5)*ui_s, ui_oy + (y + h*0.5 - 2)*ui_s,
               ui_ox + (x + w - 9)*ui_s, ui_oy + (y + h*0.5 + 3)*ui_s);
  hit && mouse_wheel != 0 ? ( p_set(i, slider(i) + (mouse_wheel > 0 ? -1 : 1)); mouse_wheel = 0; );
  hit && ui_click ? (
    gfx_x = ui_ox + x*ui_s; gfx_y = ui_oy + (y + h)*ui_s;
    ui_res = gfx_showmenu(build_menu(#menu, PENUM[i], slider(i)));
    ui_res > 0 ? p_set(i, ui_res - 1);
    ui_click = 0;
  );
  slider(i) != old;
);
// segmented switch for an enum parameter
function segs(i, x, y, w, h) local(n, j, sw, hit, on) (
  n = PMAX[i] + 1; sw = w/n; j = 0;
  loop(n,
    hit = inr(x + j*sw, y, sw, h);
    hit ? ui_hov = i;
    on = slider(i) == j;
    on ? col(acr*0.55, acg*0.55, acb*0.55, 1) : col(0.07, 0.075, 0.09, 1);
    RF(x + j*sw, y, sw, h);
    col(0.25, 0.27, 0.32, 1); RO(x + j*sw, y, sw, h);
    font(6); on ? col(1, 1, 1, 1) : col(0.6, 0.63, 0.7, 1);
    TX(list_item(#sg, PENUM[i], j), x + j*sw, y, sw, h, 5);
    hit && ui_click ? ( p_set(i, j); ui_click = 0; );
    j += 1;
  );
);
// horizontal bipolar bar (mod amounts)
function hbar(i, x, y, w, h) local(hit, n, cx) (
  hit = inr(x, y, w, h);
  begin_widget(i, hit);
  wheel_widget(i, hit);
  ui_drag == i ? p_set(i, val_of(i, ui_drag_n + (ui_mx - ui_drag_x)/w*((mouse_cap & 8) ? 0.1 : 1)));
  n = norm_of(i, slider(i));
  col(0.07, 0.075, 0.09, 1); RF(x, y, w, h);
  cx = x + w*0.5;
  col(acr, acg, acb, hit || ui_drag == i ? 1 : 0.75);
  n >= 0.5 ? RF(cx, y + 2, (n - 0.5)*w, h - 4) : RF(x + n*w, y + 2, (0.5 - n)*w, h - 4);
  col(0.35, 0.37, 0.42, 1); LN(cx, y, cx, y + h);
  col(0.25, 0.27, 0.32, 1); RO(x, y, w, h);
  font(6); col(0.9, 0.92, 0.95, 1); TX(fmt_val(#hb, i), x, y, w, h, 5);
);
function button(str, x, y, w, h) local(hit) (
  hit = inr(x, y, w, h);
  col(hit ? 0.2 : 0.13, hit ? 0.22 : 0.145, hit ? 0.26 : 0.17, 1); RF(x, y, w, h);
  col(acr, acg, acb, hit ? 1 : 0.6); RO(x, y, w, h);
  font(3); col(0.92, 0.94, 0.97, 1); TX(str, x, y, w, h, 5);
  hit && ui_click ? ( ui_click = 0; 1; ) : 0;
);

// ---------------------------------------------------------------- displays
function draw_filter_curve(x, y, w, h) local(i, f, wv, re, im, a, b, mag, db, px, py, lpx, lpy, k, fcd) (
  col(0.07, 0.075, 0.09, 1); RF(x, y, w, h);
  col(0.18, 0.19, 0.23, 1);
  f = 100; loop(3, px = x + w*log(f/20)/log(1000); LN(px, y, px, y + h); f *= 10; );
  py = y + h*18/54; LN(x, py, x + w, py);
  ftype < 5 ? (
    fcd = max(ui_fc, 10); k = reso*0.01;
    col(acr, acg, acb, 1);
    i = 0;
    loop(w/2 + 1,
      f = 20*1000^(i*2/w);
      wv = f/fcd;
      ftype == 0 ? (
        a = 1 - wv*wv; b = 2*wv;
        re = a*a - b*b + k*3.9; im = 2*a*b;
        mag = (1 + k*3.9*0.55)/sqrt(re*re + im*im);
      ) : (
        re = 1 - wv*wv; im = (2 - 1.96*k)*wv;
        mag = ftype == 1 ? 1 : ftype == 2 ? (2 - 1.96*k)*wv : ftype == 3 ? wv*wv : abs(1 - wv*wv);
        mag /= sqrt(re*re + im*im);
      );
      db = 20*log10(max(mag, 0.000001));
      px = x + i*2; py = y + h*(18 - clamp(db, -36, 18))/54;
      i > 0 ? LN(lpx, lpy, px, py);
      lpx = px; lpy = py;
      i += 1;
    );
  ) : (
    font(6); col(0.5, 0.53, 0.6, 1); TX("FILTER OFF", x, y, w, h, 5);
  );
);
function draw_scope(x, y, w, h) local(n, start, i, j, idx, v, px, py, lpx, lpy, per) (
  col(0.06, 0.065, 0.08, 1); RF(x, y, w, h);
  col(0.16, 0.17, 0.2, 1); LN(x, y + h*0.5, x + w, y + h*0.5);
  per = srate/max(ui_f0, 20);
  n = clamp(floor(per*2), 64, SCOPE_SIZE - per - 64);
  // find a rising zero crossing one window + up to one period back
  start = scope_pos - n - 2; start < 0 ? start += SCOPE_SIZE;
  j = 0;
  while (j < per && !(SCOPE[start] >= 0 && SCOPE[start > 0 ? start - 1 : SCOPE_SIZE - 1] < 0)) (
    start -= 1; start < 0 ? start += SCOPE_SIZE; j += 1;
  );
  col(acr, acg, acb, 1);
  i = 0;
  loop(w,
    idx = start + floor(i*n/w); idx >= SCOPE_SIZE ? idx -= SCOPE_SIZE;
    v = clamp(SCOPE[idx], -1, 1);
    px = x + i; py = y + h*0.5 - v*h*0.46;
    i > 0 ? LN(lpx, lpy, px, py);
    lpx = px; lpy = py;
    i += 1;
  );
);
function draw_throb(x, y, w, h) local(i, idx, v, bw) (
  col(0.06, 0.065, 0.08, 1); RF(x, y, w, h);
  bw = w/THROB_SIZE;
  col(acr, acg, acb, 0.8);
  i = 0;
  loop(THROB_SIZE,
    idx = throb_pos + i; idx >= THROB_SIZE ? idx -= THROB_SIZE;
    v = clamp(THROB[idx], 0, 1);
    RF(x + i*bw, y + h - v*h, max(bw, 1), v*h);
    i += 1;
  );
);
function draw_env(x, y, w, h, ia) local(a, d, s, r, tot, sx, px) (
  col(0.07, 0.075, 0.09, 1); RF(x, y, w, h);
  a = norm_of(ia, slider(ia)) + 0.02; d = norm_of(ia + 1, slider(ia + 1)) + 0.02;
  s = slider(ia + 2)*0.01; r = norm_of(ia + 3, slider(ia + 3)) + 0.02;
  tot = a + d + 0.6 + r; sx = w/tot;
  col(acr, acg, acb, 1);
  px = x;
  LN(px, y + h - 2, px + a*sx, y + 2); px += a*sx;
  LN(px, y + 2, px + d*sx, y + 2 + (h - 4)*(1 - s)); px += d*sx;
  LN(px, y + 2 + (h - 4)*(1 - s), px + 0.6*sx, y + 2 + (h - 4)*(1 - s)); px += 0.6*sx;
  LN(px, y + 2 + (h - 4)*(1 - s), px + r*sx, y + h - 2);
);
function draw_lfo(x, y, w, h, shape) local(i, p, v, px, py, lpx, lpy) (
  col(0.07, 0.075, 0.09, 1); RF(x, y, w, h);
  col(acr, acg, acb, 1);
  i = 0;
  loop(w + 1,
    p = frac(i/w*2);
    v = shape == 0 ? sin(2*$pi*p) : shape == 1 ? 1 - 4*abs(p - 0.5) : shape == 2 ? p + p - 1 :
        shape == 3 ? 1 - p - p : shape == 4 ? (p < 0.5 ? 1 : -1) :
        shape == 5 ? (floor(i/w*8) % 3)*0.8 - 0.8 : sin(i/w*9.7)*cos(i/w*4.1);
    px = x + i; py = y + h*0.5 - v*(h*0.5 - 3);
    i > 0 ? LN(lpx, lpy, px, py);
    lpx = px; lpy = py;
    i += 1;
  );
);

// ================================================================ presets
PRESETS = "Init - Classic Dual Saw|Saunderson '88 (CZ)|Terrorist Jungle|Mutant Techstep|Neuro Double Notch|Liquid Roller|Garage PWM|FM Growl|Sync Scream|Filter-Method Reese|Cross-Fold Mod|Yoi Talker|Tempo-Locked Throb|Barberpole Shift|Bitcrushed Sampler|Burial Rumble|Wide Unison Wall|Hoover Reese|Ring-Mod Metal|Talking Flanger";
NUM_PRESETS = enum_count(PRESETS);
function pv(i, v) ( p_put(i, v); );
function mod(slot, msrcv, dst, amt) ( pv(83 + slot*3, msrcv); pv(84 + slot*3, dst); pv(85 + slot*3, amt); );
function load_preset(n) local(i) (
  PDEF[6] = ENGDEF[0]; PDEF[7] = ENGDEF[1]; PDEF[8] = ENGDEF[2];
  i = 1; loop(100, p_put(i, PDEF[i]); i += 1; );
  n == 1 ? (
    pv(81, -5.5);
    pv(1, 3); pv(2, 14); pv(6, 35); pv(7, 0); pv(8, 100); pv(22, 420); pv(23, 10); pv(25, 30);
    pv(75, 60); pv(27, 3); pv(30, 150); pv(12, 20); pv(11, 15); pv(69, 20);
    pv(32, 600); pv(33, 20); mod(1, 3, 5, 30);
  ) : n == 2 ? (
    pv(81, -7.5);
    pv(2, 26); pv(22, 380); pv(23, 18); pv(24, 25); pv(15, 50); pv(66, 2.5); pv(65, 12);
    pv(67, 60); pv(75, 90); pv(12, 25);
  ) : n == 3 ? (
    pv(81, -7.0);
    pv(2, 34); pv(22, 1400); pv(23, 20); pv(47, 5); pv(48, 55); pv(49, 70); pv(15, 40); pv(20, 90);
    pv(52, 1); pv(53, 900); pv(54, 60); pv(55, 3); pv(56, 60);
  ) : n == 4 ? (
    pv(81, -7.0);
    pv(1, 1); pv(6, 30); pv(7, 20); pv(8, 60); pv(2, 45); pv(22, 3200); pv(23, 10);
    pv(48, 45); pv(52, 1); pv(53, 700); pv(54, 80); pv(55, 6); pv(56, 75); pv(57, 30);
    pv(68, 60); pv(15, 70); pv(20, 120); pv(72, 130); pv(73, 150);
  ) : n == 5 ? (
    pv(81, -4.0);
    pv(6, 33.4); pv(7, 20); pv(2, 12); pv(22, 220); pv(23, 25); pv(25, 50); pv(24, 15);
    pv(35, 1); pv(36, 1); pv(38, 9); mod(0, 1, 1, 12); pv(69, 50); pv(75, 200);
  ) : n == 6 ? (
    pv(81, -7.5);
    pv(1, 2); pv(2, 25); pv(6, 60); pv(7, 20); pv(8, 70); pv(22, 900); pv(23, 20); pv(75, 50);
    pv(74, 1); pv(27, 2); pv(28, 250); pv(29, 70); pv(30, 80); pv(15, 50);
  ) : n == 7 ? (
    pv(81, -7.0);
    pv(1, 4); pv(6, 45); pv(7, 20); pv(8, 30); pv(2, 20); pv(22, 2000);
    pv(35, 0); pv(36, 1); pv(38, 9); mod(0, 1, 5, 40); pv(47, 1); pv(48, 40); pv(68, 30);
    pv(15, 45); pv(20, 80);
  ) : n == 8 ? (
    pv(81, -9.0);
    pv(1, 5); pv(6, 30); pv(7, 0); pv(8, 30); pv(2, 25); pv(32, 700); pv(33, 20);
    mod(1, 3, 5, 50); pv(22, 3500); pv(23, 15); pv(47, 2); pv(48, 35); pv(52, 2); pv(55, 3);
    pv(15, 50); pv(20, 100);
  ) : n == 9 ? (
    pv(81, -3.0);
    pv(1, 6); pv(2, 25); pv(6, 60); pv(7, 50); pv(8, 60); pv(9, 2); pv(22, 1800); pv(23, 10); pv(11, 60);
  ) : n == 10 ? (
    pv(81, -6.5);
    pv(1, 7); pv(6, 40); pv(7, 60); pv(8, 50); pv(2, 18); pv(22, 2500); pv(23, 5);
    mod(2, 6, 5, 50); pv(15, 40); pv(20, 80);
  ) : n == 11 ? (
    pv(81, -6.0);
    pv(2, 40); pv(22, 5000); pv(23, 0); pv(60, 100); pv(59, 20); pv(35, 1); pv(36, 1); pv(38, 6);
    mod(0, 1, 12, 45); pv(48, 50); pv(68, 40); pv(15, 60); pv(20, 100);
  ) : n == 12 ? (
    pv(81, -6.0);
    pv(3, 2); pv(5, 9); pv(22, 700); pv(23, 25); mod(5, 10, 1, 25); pv(15, 40);
  ) : n == 13 ? (
    pv(81, -2.5);
    pv(1, 1); pv(6, 30); pv(61, 3); pv(62, 50); pv(22, 2000); pv(11, 50); pv(15, 40); pv(20, 80);
  ) : n == 14 ? (
    pv(81, -6.0);
    pv(2, 28); pv(65, 8); pv(66, 3.3); pv(67, 100); pv(22, 900); pv(12, 40); pv(24, 30);
  ) : n == 15 ? (
    pv(81, -4.0);
    pv(2, 10); pv(22, 260); pv(23, 10); pv(15, 30); pv(65, 10); pv(66, 1.5); pv(67, 40);
    pv(69, 35); pv(12, 50); pv(27, 60); pv(30, 900); pv(41, 6); mod(3, 2, 1, 15);
  ) : n == 16 ? (
    pv(81, -6.5);
    pv(9, 4); pv(10, 40); pv(11, 80); pv(2, 30); pv(22, 2500); pv(73, 180); pv(20, 80);
    pv(15, 60); pv(69, 30); pv(72, 150);
  ) : n == 17 ? (
    pv(81, -6.0);
    pv(1, 2); pv(6, 80); pv(2, 35); pv(8, 100); pv(9, 3); pv(10, 60); pv(22, 3000); pv(75, 150);
    pv(31, 1); pv(32, 150); pv(33, 0); mod(1, 3, 4, -8); pv(76, 1);
  ) : n == 18 ? (
    pv(81, -4.0);
    pv(63, 1.5); pv(64, 60); pv(22, 1500); pv(15, 50); pv(20, 100);
  ) : n == 19 ? (
    pv(81, -2.5);
    pv(52, 3); pv(53, 300); pv(54, 70); pv(55, 3); pv(56, 80); pv(22, 2200);
  );
  cur_preset = n; preset_edited = 0;
);

// ================================================================ mutate
function rnd(a, b) ( a + rand(1)*(b - a); );
function chance(p) ( rand(1) < p; );
function mutate(mode) local(i, s) (
  mode == 0 || mode == 3 ? (                                   // engine
    pv(1, floor(rand(8))); pv(6, rnd(0, 100)); pv(7, rnd(0, 100)); pv(8, rnd(20, 100));
    pv(2, rnd(8, 60)); pv(9, chance(0.6) ? 1 : floor(rnd(2, 5))); pv(10, rnd(10, 60));
    pv(11, rnd(10, 70)); pv(12, rnd(0, 50));
  );
  mode == 1 || mode == 3 ? (                                   // mangle + movement
    pv(60, chance(0.4) ? rnd(40, 100) : 0); pv(59, rnd(0, 100));
    pv(62, chance(0.25) ? rnd(20, 70) : 0); pv(61, rnd(-1, 1)^3*300);
    pv(64, chance(0.25) ? rnd(20, 80) : 0); pv(63, chance(0.5) ? 0.5*floor(rnd(1, 7)) : rnd(0.25, 4));
    chance(0.3) ? ( pv(65, rnd(4, 12)); pv(66, rnd(1, 6)); pv(67, rnd(30, 100)); ) : ( pv(65, 16); pv(66, 1); );
    pv(68, chance(0.5) ? rnd(0, 70) : 0);
    pv(52, chance(0.7) ? floor(rnd(1, 4)) : 0); pv(53, 2^rnd(7, 12)); pv(54, rnd(20, 90));
    pv(55, floor(rnd(2, 13))); pv(56, rnd(10, 85)); pv(57, rnd(0, 60));
    pv(47, floor(rand(6))); pv(48, rnd(0, 70)); pv(49, rnd(50, 100));
  );
  mode == 2 || mode == 3 ? (                                   // modulation
    pv(35, floor(rand(7))); pv(36, 1); pv(38, floor(rnd(3, 13))); pv(41, floor(rand(7)));
    pv(43, 2^rnd(-3, 3)); pv(32, 2^rnd(6, 11));
    i = 0;
    loop(4,
      mod(i, floor(rnd(1, 11)), chance(0.7) ? floor(rnd(1, 16)) : 0, rnd(-60, 60));
      i += 1;
    );
  );
  mode == 3 ? ( pv(22, 2^rnd(8, 12)); pv(23, rnd(0, 50)); );
  mode == 4 ? (                                                // nudge everything a little
    i = 1;
    loop(82,
      !PSTEP[i] && i != 81 && i != 14 && i != 15 ? pv(i, val_of(i, norm_of(i, slider(i)) + rnd(-0.06, 0.06)));
      i += 1;
    );
  );
  preset_edited = 1;
);

gfx_ext_retina = 1;
ui_drag = 0; ui_page = 0; cur_preset = 0; preset_edited = 0; preset_loaded_once = 0;

@slider
update_params();

@block
(ui_dirty || srate != last_srate) ? ( ui_dirty = 0; update_params(); );
mq_n = 0; mq_i = 0; spl_ctr = 0;
while (midirecv(mofs, m1, m2, m3)) (
  mq_n < 2000 ? (
    MQ[mq_n*4] = mofs; MQ[mq_n*4 + 1] = m1; MQ[mq_n*4 + 2] = m2; MQ[mq_n*4 + 3] = m3;
    mq_n += 1;
  );
);
qn_per_s = tempo/60;
beat_position_now = beat_position;
// transport lock for tempo-synced LFOs / movement
playing = play_state & 1;
playing ? (
  l1sync && !l1trig ? lfo1.ph = frac(beat_position/BEATS[l1div]);
  l2sync && !l2trig ? lfo2.ph = frac(beat_position/BEATS[l2div]);
  mv_ph = frac(beat_position/BEATS[mvrate]);
);

@sample
// ------------------------------------------------ MIDI due at this sample
while (mq_i < mq_n && MQ[mq_i*4] <= spl_ctr) (
  handle_midi(MQ[mq_i*4 + 1], MQ[mq_i*4 + 2], MQ[mq_i*4 + 3]);
  mq_i += 1;
);
spl_ctr += 1;
beat_position_now += qn_per_s*isr;

// ------------------------------------------------ modulation sources
aenv = aenv_o.env_tick(a_ca, a_cd, asus_n, a_cr);
menv = menv_o.env_tick(m_ca, m_cd, msus_n, m_cr);
note_time += isr;
r1 = (l1sync ? qn_per_s/BEATS[l1div] : l1rate)*2^(MODV[23]*3);
r2 = (l2sync ? qn_per_s/BEATS[l2div] : l2rate)*2^(MODV[24]*3);
lfo1v = lfo1.lfo_tick(l1shape, r1);
lfo2v = lfo2.lfo_tick(l2shape, r2);
l1fade > 0 ? lfo1v *= min(1, note_time*1000/l1fade);
l2fade > 0 ? lfo2v *= min(1, note_time*1000/l2fade);
SRC[1] = lfo1v; SRC[2] = lfo2v; SRC[3] = menv; SRC[4] = aenv; SRC[5] = vel;
SRC[6] = modwheel; SRC[7] = aftertouch; SRC[8] = clamp((cur_pitch - 48)/24, -1, 1);
SRC[9] = note_rnd; SRC[10] = cos(2*$pi*beat_ph);
mi = 0; loop(n_mod, MODV[MDST[mi]] = 0; mi += 1; );
mi = 0; loop(n_mod, MODV[MDST[mi]] += SRC[MSRC[mi]]*MAMT[mi]; mi += 1; );

// ------------------------------------------------ smoothed parameters
sm_lcut += (lcut_target - sm_lcut)*smc;
sm_det += (det - sm_det)*smc;
sm_beathz += (beathz - sm_beathz)*smc;
sm_a += (enga - sm_a)*smc; sm_b += (engb - sm_b)*smc; sm_c += (engc - sm_c)*smc;
sm_vol += (vol_target - sm_vol)*smc;

// ------------------------------------------------ pitch
cur_pitch += (tgt_pitch - cur_pitch)*gcoef;
pitch = cur_pitch + octave*12 + bend_v*bendr + MODV[4]*24;
f0 = 440*2^((pitch - 69)/12);

// ------------------------------------------------ detune / beat
detmode == 0 ? (
  dc = sm_det + MODV[3]*100;
  beat_eff = f0*(2^(dc/1200) - 1);
) : (
  bhz = (detmode == 1 ? sm_beathz : qn_per_s/BEATS[beatdiv]) + MODV[3]*10;
  beat_eff = bhz;
);
beat_ph += beat_eff*isr; beat_ph -= floor(beat_ph);

ea = clamp(sm_a + MODV[5]*100, 0, 100)*0.01;
eb = clamp(sm_b + MODV[6]*100, 0, 100)*0.01;
ec = clamp(sm_c + MODV[7]*100, 0, 100)*0.01;
us_eff = clamp(uspread + MODV[16]*100, 0, 100)*0.6;
sp_eff = clamp(spread + MODV[17]*100, 0, 100)*0.01;
abs(sp_eff - last_spread) > 0.0005 ? ( update_pans(sp_eff); last_spread = sp_eff; );

// ------------------------------------------------ engine parameters
g0 = 1; g1 = 1; detscale = 1;
eng == 0 ? (
  morph = ea; interval = INTV[floor(eb*7.999)];
  g0 = min(1, 2 - ec - ec); g1 = min(1, ec + ec);
) : eng == 1 ? (
  ss_curve = 1 + eb*2;
) : eng == 2 ? (
  detscale = 0; g1 = ec;
  pw0 = clamp(0.5 - eb*0.45 + ea*0.45*tri(beat_ph), 0.03, 0.97);
  pw1 = clamp(0.5 - eb*0.45 + ea*0.45*tri(frac(beat_ph + 0.25)), 0.03, 0.97);
) : eng == 3 ? (
  cz_d = ea*0.98; cz_w = floor(eb*5.999); g1 = ec;
) : eng == 4 ? (
  fm_idx = ea*8; fm_ratio = FMR[floor(eb*5.999)]; fm_fb = ec*1.4;
) : eng == 5 ? (
  sy_ratio = 1 + ea*7; sy_morph = eb; sy_mix = ec;
) : eng == 6 ? (
  detscale = 0;
  ph_fb = eb*0.85;
  ph_stages = 2*(1 + floor(ec*5.999));
  tl = tri(beat_ph); tr = tri(frac(beat_ph + sp_eff*0.25));
  fcl = f0*2^(1 + (tl + 1)*ea*2.5); fcr = f0*2^(1 + (tr + 1)*ea*2.5);
  tl = tan($pi*clamp(fcl, 20, fs_os*0.45)*isr_os); ph_al = (tl - 1)/(tl + 1);
  tr = tan($pi*clamp(fcr, 20, fs_os*0.45)*isr_os); ph_ar = (tr - 1)/(tr + 1);
) : (
  fo_gain = 1 + ea*7; fo_xm = eb; fo_sym = (ec - 0.5);
);

// ------------------------------------------------ per-oscillator frequencies
drift_ctr -= 1;
drift_ctr <= 0 ? (
  drift_ctr = floor(srate*0.35);
  k = 0; loop(nosc, O_DTGT[k] = rand(2) - 1; k += 1; );
);
drift_c = drift*0.12;
sumsq = 0;
k = 0;
loop(nosc,
  O_DRIFT[k] += (O_DTGT[k] - O_DRIFT[k])*drift_k;
  pos = O_POSR[k];
  eng == 1 ? pos = (pos < 0 ? -1 : 1)*abs(pos)^ss_curve;
  pos *= detscale;
  cents = O_UNI[k]*us_eff*0.5 + O_DRIFT[k]*drift_c + (eng == 0 && O_SLOT[k] == 1 ? interval*100 : 0);
  detmode == 0 ? (
    fk = f0*exp((pos*dc*0.5 + cents)*0.0005776226504666211);
  ) : (
    fk = max(f0 + pos*bhz*0.5, 1)*exp(cents*0.0005776226504666211);
  );
  O_DT[k] = min(fk*isr_os, 0.45);
  eng == 4 ? O_DT2[k] = min(f0*fm_ratio*exp(cents*0.0005776226504666211)*isr_os, 0.45) :
  eng == 5 ? O_DT2[k] = min(O_DT[k]*sy_ratio, 0.45) :
  eng == 7 ? (
    detmode == 0 ? fk = f0*exp((-pos*dc*0.5 + cents)*0.0005776226504666211) :
                   fk = max(f0 - pos*bhz*0.5, 1)*exp(cents*0.0005776226504666211);
    O_DT2[k] = min(fk*isr_os, 0.45);
  );
  lv = eng == 1 ? 1 + (ec - 1)*abs(O_POSR[k]) : (O_SLOT[k] == 0 ? g0 : g1);
  O_FB[k + 32] = lv;
  sumsq += lv*lv;
  k += 1;
);
norm = osc_gain*0.9/sqrt(max(sumsq, 0.25));

// ------------------------------------------------ filter / drive coefficients
fc = 2^(sm_lcut + fkey*0.01*(pitch - 48)/12 + fenv*0.06*menv + MODV[1]*6);
calc_filter(fc, clamp(reso + MODV[2]*100, 0, 100)*0.01);
fdv = clamp(fdrive + MODV[8]*100, 0, 100);
fdrv_on = fdv > 0.05;
fdg = 1 + fdv*0.07; fdg_out = fdg^(-0.25);
ddv = clamp(ddrive + MODV[9]*100, 0, 100);
dist_on = ddv > 0.05;
d_gain = db2g(ddv*0.36);
noise_on = noiselvl > 0 || MODV[22] != 0;
n_lvl = clamp(noiselvl + MODV[22]*100, 0, 100)*0.006;

// ------------------------------------------------ oscillators (oversampled)
voice_on = aenv_o.st > 0;
!voice_on && voice_was_on ? voice_reset();
voice_was_on = voice_on;
voice_on ? (
  loop(os,
    sl = 0; sr = 0; k = 0;
    eng == 0 ? (
      loop(nosc,
        dt = O_DT[k]; ph = O_PH[k] + dt; ph >= 1 ? ph -= 1; O_PH[k] = ph;
        y = (O_SLOT[k] < 0.5 ? ph + ph - 1 - blep(ph, dt) : wave_morph(ph, dt, morph))*O_FB[k + 32];
        sl += y*O_GL[k]; sr += y*O_GR[k];
        k += 1;
      );
    ) : eng == 1 ? (
      loop(nosc,
        dt = O_DT[k]; ph = O_PH[k] + dt; ph >= 1 ? ph -= 1; O_PH[k] = ph;
        y = (ph + ph - 1 - blep(ph, dt))*O_FB[k + 32];
        sl += y*O_GL[k]; sr += y*O_GR[k];
        k += 1;
      );
    ) : eng == 2 ? (
      loop(nosc,
        dt = O_DT[k]; ph = O_PH[k] + dt; ph >= 1 ? ph -= 1; O_PH[k] = ph;
        y = pulse(ph, dt, O_SLOT[k] < 0.5 ? pw0 : pw1)*O_FB[k + 32];
        sl += y*O_GL[k]; sr += y*O_GR[k];
        k += 1;
      );
    ) : eng == 3 ? (
      loop(nosc,
        dt = O_DT[k]; ph = O_PH[k] + dt; ph >= 1 ? ph -= 1; O_PH[k] = ph;
        y = cz_wave(ph, dt, cz_d, cz_w)*O_FB[k + 32];
        sl += y*O_GL[k]; sr += y*O_GR[k];
        k += 1;
      );
    ) : eng == 4 ? (
      loop(nosc,
        ph = O_PH[k] + O_DT[k]; ph >= 1 ? ph -= 1; O_PH[k] = ph;
        ph2 = O_PH2[k] + O_DT2[k]; ph2 >= 1 ? ph2 -= 1; O_PH2[k] = ph2;
        m = sin(2*$pi*ph2 + fm_fb*O_FB[k]);
        O_FB[k] = m;
        y = sin(2*$pi*ph + fm_idx*m)*O_FB[k + 32];
        sl += y*O_GL[k]; sr += y*O_GR[k];
        k += 1;
      );
    ) : eng == 5 ? (
      loop(nosc,
        dt = O_DT[k]; ph = O_PH[k] + dt;
        dt2 = O_DT2[k]; ph2 = O_PH2[k] + dt2;
        ph >= 1 ? ( ph -= 1; ph2 = ph*(dt2/dt); ) : ( ph2 >= 1 ? ph2 -= floor(ph2); );
        O_PH[k] = ph; O_PH2[k] = ph2;
        y = ph2 + ph2 - 1;
        sy_morph > 0 ? y += ((ph2 < 0.5 ? 1 : -1) - y)*sy_morph;
        y += sy_mix*(ph + ph - 1 - blep(ph, dt));
        y *= O_FB[k + 32]*0.8;
        sl += y*O_GL[k]; sr += y*O_GR[k];
        k += 1;
      );
    ) : eng == 6 ? (
      loop(nosc,
        dt = O_DT[k]; ph = O_PH[k] + dt; ph >= 1 ? ph -= 1; O_PH[k] = ph;
        y = (ph + ph - 1 - blep(ph, dt))*O_FB[k + 32];
        sl += y*O_GL[k]; sr += y*O_GR[k];
        k += 1;
      );
    ) : (
      loop(nosc,
        ph = O_PH[k] + O_DT[k]; ph >= 1 ? ph -= 1; O_PH[k] = ph;
        ph2 = O_PH2[k] + O_DT2[k]; ph2 >= 1 ? ph2 -= 1; O_PH2[k] = ph2;
        y = sin(2*$pi*ph)*fo_gain*(1 + fo_xm*sin(2*$pi*ph2));
        y = sin((y + fo_sym)*1.5707963)*O_FB[k + 32];
        sl += y*O_GL[k]; sr += y*O_GR[k];
        k += 1;
      );
    );
    sl *= norm; sr *= norm;
    eng == 6 ? ( sl = eng_phaser(sl, PHS_L, ph_al); sr = eng_phaser(sr, PHS_R, ph_ar); );
    noise_on ? (
      nw = rand(2) - 1; n_sl += (nw - n_sl)*n_c; sl += (n_lpmode ? n_sl : nw - n_sl)*n_lvl;
      nw = rand(2) - 1; n_sr += (nw - n_sr)*n_c; sr += (n_lpmode ? n_sr : nw - n_sr)*n_lvl;
    );
    dist_on && dpos == 1 ? ( sl = dsl.dist(sl); sr = dsr.dist(sr); );
    ftype < 5 ? ( sl = fl.filt(sl); sr = fr.filt(sr); );
    dist_on && dpos == 0 ? ( sl = dsl.dist(sl); sr = dsr.dist(sr); );
    os == 2 ? ( sl = decl.dec2(sl); sr = decr.dec2(sr); ) :
    os == 4 ? ( sl = decl.dec4(sl); sr = decr.dec4(sr); );
  );
) : ( sl = sr = 0; );

// ------------------------------------------------ DC blocker + VCA
dcy_l = sl - dcx_l + dc_r*dcy_l; dcx_l = sl;
dcy_r = sr - dcx_r + dc_r*dcy_r; dcx_r = sr;
velg += (1 - velsens*0.01*(1 - vel) - velg)*vel_c;
vca = aenv*velg*clamp(1 + MODV[19], 0, 2);
xl = dcy_l*vca; xr = dcy_r*vca;

// ------------------------------------------------ MANGLE: formant
fm_eff = fmix*0.01;
fm_eff > 0 ? (
  sm_vowel += (clamp(vowel + MODV[12]*100, 0, 100) - sm_vowel)*smc;
  vp = sm_vowel*0.03999; vi = floor(vp); vf = vp - vi;
  vi = FORMT + vi*6;
  ff1 = vi[0] + (vi[6] - vi[0])*vf; ff2 = vi[1] + (vi[7] - vi[1])*vf; ff3 = vi[2] + (vi[8] - vi[2])*vf;
  fg1 = vi[3] + (vi[9] - vi[3])*vf; fg2 = vi[4] + (vi[10] - vi[4])*vf; fg3 = vi[5] + (vi[11] - vi[5])*vf;
  fo1l.svf_set(ff1, 0.12); fo1r.svf_same();
  fo2l.svf_set(ff2, 0.1); fo2r.svf_same();
  fo3l.svf_set(ff3, 0.08); fo3r.svf_same();
  fo1l.svf(xl); fo2l.svf(xl); fo3l.svf(xl);
  fo1r.svf(xr); fo2r.svf(xr); fo3r.svf(xr);
  wl = (fo1l.bp*0.12*fg1 + fo2l.bp*0.1*fg2 + fo3l.bp*0.08*fg3)*3.5;
  wr = (fo1r.bp*0.12*fg1 + fo2r.bp*0.1*fg2 + fo3r.bp*0.08*fg3)*3.5;
  xl += (wl - xl)*fm_eff; xr += (wr - xr)*fm_eff;
);
// ------------------------------------------------ MANGLE: ring mod (key tracked)
ringmix > 0 ? (
  ring_ph += f0*clamp(ring*2^(MODV[14]*3), 0.05, 32)*isr; ring_ph -= floor(ring_ph);
  rc = sin(2*$pi*ring_ph);
  xl += (xl*rc - xl)*ringmix*0.01; xr += (xr*rc - xr)*ringmix*0.01;
);
// ------------------------------------------------ MANGLE: frequency shifter
shmix > 0 ? (
  sm_shift += (clamp(fshift + MODV[13]*1000, -2000, 2000) - sm_shift)*smc;
  sh_ph += sm_shift*isr; sh_ph -= floor(sh_ph);
  shc = cos(2*$pi*sh_ph); shs = sin(2*$pi*sh_ph);
  re = hilbert(xl, HIL_L); wl = re*shc - hil_im*shs;
  re = hilbert(xr, HIL_R); wr = re*shc - hil_im*shs;
  xl += (wl - xl)*shmix*0.01; xr += (wr - xr)*shmix*0.01;
);
// ------------------------------------------------ MANGLE: bit crush / downsample
(crush_on || MODV[15] != 0) && cmix > 0 ? (
  cb = clamp(bits - MODV[15]*14, 1, 16);
  cq = 2^(cb - 1);
  cr_acc += 1;
  cr_acc >= downs ? (
    cr_acc -= downs;
    cr_hl = floor(xl*cq + 0.5)/cq; cr_hr = floor(xr*cq + 0.5)/cq;
  );
  xl += (cr_hl - xl)*cmix*0.01; xr += (cr_hr - xr)*cmix*0.01;
);

// ------------------------------------------------ MOVEMENT
mv_ph += qn_per_s/BEATS[mvrate]*isr; mv_ph -= floor(mv_ph);
mvtype > 0 ? (
  sm_mvf += (mvf_target - sm_mvf)*smc;
  mvm = clamp(mvmix + MODV[11]*100, 0, 100)*0.01;
  mtl = tri(mv_ph); mtr = tri(frac(mv_ph + mvstereo*0.005));
  mfl = 2^(sm_mvf + mtl*mvdepth*0.02 + MODV[10]*5);
  mfr = 2^(sm_mvf + mtr*mvdepth*0.02 + MODV[10]*5);
  mvtype == 1 ? (
    mk = 2 - mvreso*0.019;
    mn1l.svf_set(mfl, mk); mn2l.svf_set(mfl*2, mk);
    mn1r.svf_set(mfr, mk); mn2r.svf_set(mfr*2, mk);
    mn1l.svf(xl); wl = mn1l.lp + mn1l.hp; mn2l.svf(wl); wl = mn2l.lp + mn2l.hp;
    mn1r.svf(xr); wr = mn1r.lp + mn1r.hp; mn2r.svf(wr); wr = mn2r.lp + mn2r.hp;
  ) : mvtype == 2 ? (
    tl = tan($pi*clamp(mfl, 20, srate*0.45)*isr); mal = (tl - 1)/(tl + 1);
    tr = tan($pi*clamp(mfr, 20, srate*0.45)*isr); mar = (tr - 1)/(tr + 1);
    mfbk = mvreso*0.0085;
    wl = xl + mph_fbl*mfbk; wr = xr + mph_fbr*mfbk;
    i = 0;
    loop(6,
      v = mal*wl + MPH_L[i]; MPH_L[i] = wl - mal*v; wl = v;
      v = mar*wr + MPH_R[i]; MPH_R[i] = wr - mar*v; wr = v;
      i += 1;
    );
    mph_fbl = wl; mph_fbr = wr;
    wl = 0.5*(xl + wl); wr = 0.5*(xr + wr);
  ) : (
    mfbk = mvreso*0.0092;
    dl = clamp(srate/mfl, 2, FLB_SIZE - 4); dr = clamp(srate/mfr, 2, FLB_SIZE - 4);
    tl = dread(FLB_L, FLB_SIZE, fl_pos, dl); tr = dread(FLB_R, FLB_SIZE, fl_pos, dr);
    FLB_L[fl_pos] = xl + tl*mfbk; FLB_R[fl_pos] = xr + tr*mfbk;
    fl_pos += 1; fl_pos >= FLB_SIZE ? fl_pos = 0;
    wl = 0.5*(xl + tl); wr = 0.5*(xr + tr);
  );
  xl += (wl - xl)*mvm; xr += (wr - xr)*mvm;
);

// ------------------------------------------------ SQUASH (3-band up/down compressor)
squash > 0 ? (
  sq_l1.svf(xl); sq_l2.svf(sq_l1.lp); bl_l = sq_l2.lp; rl = xl - bl_l;
  sq_r1.svf(xr); sq_r2.svf(sq_r1.lp); bl_r = sq_r2.lp; rr = xr - bl_r;
  sq_m1.svf(rl); sq_m2.svf(sq_m1.lp); bm_l = sq_m2.lp; bh_l = rl - bm_l;
  sq_m3.svf(rr); sq_m4.svf(sq_m3.lp); bm_r = sq_m4.lp; bh_r = rr - bm_r;
  e = max(abs(bl_l), abs(bl_r)); sq_el += (e - sq_el)*(e > sq_el ? sq_att : sq_rel);
  e = max(abs(bm_l), abs(bm_r)); sq_em += (e - sq_em)*(e > sq_em ? sq_att : sq_rel);
  e = max(abs(bh_l), abs(bh_r)); sq_eh += (e - sq_eh)*(e > sq_eh ? sq_att : sq_rel);
  sqd = squash*0.007;
  gl_ = clamp((0.3/(sq_el + 0.0001))^sqd, 0.2, 6);
  gm_ = clamp((0.2/(sq_em + 0.0001))^sqd, 0.2, 8);
  gh_ = clamp((0.12/(sq_eh + 0.0001))^sqd, 0.2, 10);
  xl = bl_l*gl_ + bm_l*gm_ + bh_l*gh_;
  xr = bl_r*gl_ + bm_r*gm_ + bh_r*gh_;
);

// ------------------------------------------------ Reese low cut (for sub layering)
lowcut > 0 ? (
  lc1.svf(xl); lc2.svf(lc1.hp); xl = lc2.hp;
  lc3.svf(xr); lc4.svf(lc3.hp); xr = lc4.hp;
);

// ------------------------------------------------ chorus
chmix > 0 ? (
  ch_ph += chrate*isr; ch_ph -= floor(ch_ph);
  CHB_L[ch_pos] = xl; CHB_R[ch_pos] = xr;
  cdl = (8 + chdepth*0.04*(1 + sin(2*$pi*ch_ph)))*0.001*srate;
  cdr = (8 + chdepth*0.04*(1 + cos(2*$pi*ch_ph)))*0.001*srate;
  wl = dread(CHB_L, CHB_SIZE, ch_pos, cdl); wr = dread(CHB_R, CHB_SIZE, ch_pos, cdr);
  ch_pos += 1; ch_pos >= CHB_SIZE ? ch_pos = 0;
  chm = chmix*0.01;
  xl = xl*(1 - chm*0.35) + wr*chm*0.75;
  xr = xr*(1 - chm*0.35) + wl*chm*0.75;
);
// ------------------------------------------------ width
wd = clamp(width + MODV[18]*200, 0, 200)*0.01;
wd != 1 ? ( mid = (xl + xr)*0.5; sid = (xl - xr)*0.5*wd; xl = mid + sid; xr = mid - sid; );
// ------------------------------------------------ mono bass
monobass > 0 ? (
  mb1.svf(xl); mb2.svf(mb1.lp); lo_l = mb2.lp;
  mb3.svf(xr); mb4.svf(mb3.lp); lo_r = mb4.lp;
  lo_m = (lo_l + lo_r)*0.5;
  xl += lo_m - lo_l; xr += lo_m - lo_r;
);

// ------------------------------------------------ sub oscillator
sl_eff = clamp(sublvl + MODV[21]*100, 0, 100);
sl_eff > 0 && voice_on ? (
  sdt = f0*2^(-suboct)*isr;
  sub_ph += sdt; sub_ph >= 1 ? sub_ph -= 1;
  subwave == 0 ? sb = sin(2*$pi*sub_ph) :
  subwave == 1 ? sb = tri(sub_ph) :
  subwave == 2 ? sb = pulse(sub_ph, sdt, 0.5)*0.6 :
  sb = saw(sub_ph, sdt)*0.6;
  sb *= sl_eff*0.009*aenv*velg*clamp(1 + MODV[19], 0, 2);
  xl += sb; xr += sb;
);

// ------------------------------------------------ output
pn = clamp(MODV[20], -1, 1);
pn != 0 ? ( xl *= min(1, 1 - pn); xr *= min(1, 1 + pn); );
xl *= sm_vol; xr *= sm_vol;
limiter ? (
  xl = abs(xl) < 0.85 ? xl : (xl > 0 ? 1 : -1)*(0.85 + 0.15*sat((abs(xl) - 0.85)/0.15));
  xr = abs(xr) < 0.85 ? xr : (xr > 0 ? 1 : -1)*(0.85 + 0.15*sat((abs(xr) - 0.85)/0.15));
);
spl0 = xl; spl1 = xr;

// ------------------------------------------------ scope / throb meter for UI
SCOPE[scope_pos] = (xl + xr)*0.5;
scope_pos += 1; scope_pos >= SCOPE_SIZE ? scope_pos = 0;
throb_acc = max(throb_acc, abs(xl) + abs(xr));
throb_n += 1;
throb_n >= 512 ? (
  THROB[throb_pos] = throb_acc*0.5; throb_pos += 1; throb_pos >= THROB_SIZE ? throb_pos = 0;
  throb_acc = 0; throb_n = 0;
);
ui_f0 = f0; ui_beat = beat_eff; ui_fc = fc;

@gfx 960 684
// ---------------------------------------------------------------- frame setup
// Paged UI on a 960 x 684 logical canvas, scaled to the window. Pages: 0 synth, 1 mod, 2 fx.
// NOTE: @gfx runs in its own thread - only use ui_* globals (or function locals) here, never
// variables the audio code writes (the transpiler rejects shared writes).
UI_W = 960; UI_H = 684;
ui_s = min(gfx_w/UI_W, gfx_h/UI_H);
ui_s <= 0 ? ui_s = 1;
ui_ox = floor((gfx_w - UI_W*ui_s)*0.5); ui_oy = floor((gfx_h - UI_H*ui_s)*0.5);
ui_s != ui_last_s ? ( setup_fonts(ui_s); ui_last_s = ui_s; );
ui_mx = (mouse_x - ui_ox)/ui_s; ui_my = (mouse_y - ui_oy)/ui_s;
ui_now = time_precise();
gfx_getchar();   // makes mouse_cap report ctrl/shift even when the mouse isn't captured
ui_click = (mouse_cap & 1) && !(ui_last_cap & 1);
ui_release = !(mouse_cap & 1) && (ui_last_cap & 1);
ui_release ? (
  ui_drag > 0 ? automate(ui_drag, 1);
  ui_drag = 0;
);
ui_hov = 0;

col(0.075, 0.08, 0.095, 1); gfx_rect(0, 0, gfx_w, gfx_h);

// ---------------------------------------------------------------- header
accent(0.24, 0.9, 0.76);
font(4); col(0.95, 0.97, 1, 1); TX("REESE", 14, 6, 100, 30, 4);
col(acr, acg, acb, 1); TX("BASSER", 118, 6, 130, 30, 4);
font(6); col(0.5, 0.53, 0.6, 1); TX("detuned bass synthesizer", 16, 35, 220, 11, 0);
// preset selector
col(0.07, 0.075, 0.09, 1); RF(292, 8, 290, 32);
col(0.25, 0.27, 0.32, 1); RO(292, 8, 290, 32);
button("<", 262, 8, 28, 32) ? ( load_preset(cur_preset > 0 ? cur_preset - 1 : NUM_PRESETS - 1); preset_loaded_once = 1; );
button(">", 584, 8, 28, 32) ? ( load_preset(cur_preset < NUM_PRESETS - 1 ? cur_preset + 1 : 0); preset_loaded_once = 1; );
font(5); col(0.92, 0.94, 0.97, 1);
list_item(#pn, PRESETS, cur_preset);
preset_edited ? strcat(#pn, " *");
!preset_loaded_once && !preset_edited ? strcpy(#pn, "Custom / Project Patch");
TX(#pn, 292, 8, 290, 32, 5);
inr(292, 8, 290, 32) && ui_click ? (
  gfx_x = ui_ox + 292*ui_s; gfx_y = ui_oy + 40*ui_s;
  ui_res = gfx_showmenu(build_menu(#menu, PRESETS, preset_loaded_once ? cur_preset : -1));
  ui_res > 0 ? ( load_preset(ui_res - 1); preset_loaded_once = 1; );
  ui_click = 0;
);
accent(1.0, 0.35, 0.55);
button("MUTATE", 628, 8, 110, 32) ? (
  gfx_x = ui_ox + 628*ui_s; gfx_y = ui_oy + 40*ui_s;
  ui_res = gfx_showmenu("Mutate engine|Mutate mangle + movement|Mutate modulation|Mutate everything||Nudge all (subtle)");
  ui_res > 0 ? mutate(ui_res - 1);
);
// live readout
font(6); col(0.5, 0.53, 0.6, 1);
sprintf(#ro, "note %.1f Hz", ui_f0); TX(#ro, 750, 8, 198, 12, 2);
sprintf(#ro, "beat %.2f Hz", abs(ui_beat)); TX(#ro, 750, 21, 198, 12, 2);
sprintf(#ro, "%s  |  %dx oversampling", aenv_o.st > 0 ? "voice on" : "idle", quality == 0 ? 1 : quality == 1 ? 2 : 4);
TX(#ro, 750, 34, 198, 12, 2);

// ---------------------------------------------------------------- page tabs
function tab(str, x, w, page) local(hit, on) (
  hit = inr(x, 52, w, 30); on = ui_page == page;
  on ? col(acr*0.45, acg*0.45, acb*0.45, 1) : col(hit ? 0.15 : 0.11, hit ? 0.165 : 0.12, hit ? 0.2 : 0.145, 1);
  RF(x, 52, w, 30);
  col(acr, acg, acb, on ? 1 : 0.35); RF(x, 79, w, 3);
  col(0.22, 0.24, 0.28, 1); RO(x, 52, w, 30);
  font(3); on ? col(1, 1, 1, 1) : col(0.62, 0.65, 0.72, 1); TX(str, x, 52, w, 30, 5);
  hit && ui_click ? ( ui_page = page; ui_click = 0; );
);
accent(0.24, 0.9, 0.76); tab("SYNTH", 10, 150, 0);
accent(0.35, 0.65, 1.0); tab("MODULATION", 166, 150, 1);
accent(1.0, 0.35, 0.55); tab("FX + MANGLE", 322, 150, 2);
// mini scope so the throb stays visible on every page
ui_page != 0 ? (
  accent(0.24, 0.9, 0.76);
  draw_scope(620, 52, 330, 30);
  col(0.22, 0.24, 0.28, 1); RO(620, 52, 330, 30);
);

// ================================================================ PAGE: SYNTH
ui_page == 0 ? (
  // -------------------------------------------------------------- engine
  accent(0.24, 0.9, 0.76);
  panel(10, 92, 600, 300, "OSCILLATOR ENGINE");
  dropdown(1, 200, 97, 270, 24) ? engine_defaults();
  // double-click defaults of A/B/C follow the current engine
  PDEF[6] = ENGDEF[eng*3]; PDEF[7] = ENGDEF[eng*3 + 1]; PDEF[8] = ENGDEF[eng*3 + 2];
  font(6); col(0.55, 0.58, 0.65, 1); TX(ENGDESC[eng], 20, 126, 580, 12, 0);
  detmode == 0 ? knob(2, 18, 148, "DETUNE") : detmode == 1 ? knob(4, 18, 148, "BEAT HZ") : knob(5, 18, 148, "BEAT SYNC");
  knob(6, 90, 148, ENGLBL[eng*3]);
  knob(7, 162, 148, ENGLBL[eng*3 + 1]);
  knob(8, 234, 148, ENGLBL[eng*3 + 2]);
  eng != 1 ? (
    knob(9, 306, 148, "UNISON"); knob(10, 378, 148, "UNI DET");
  ) : (
    font(6); col(0.35, 0.37, 0.42, 1);
    TX("UNISON", 306, 194, 66, 12, 1); TX("UNI DET", 378, 194, 66, 12, 1);
    TX("(supersaw", 306, 208, 138, 12, 1); TX("has its own voices)", 306, 220, 138, 12, 1);
  );
  knob(11, 450, 148, "STEREO");
  knob(12, 522, 148, "DRIFT");
  small_caption("DETUNE MODE", 20, 230, 180);
  segs(3, 20, 246, 180, 24);
  small_caption("OSC PHASE", 212, 230, 180);
  segs(13, 212, 246, 180, 24);
  font(6); col(0.5, 0.53, 0.6, 1);
  TX(detmode == 0 ? "beat follows pitch" : detmode == 1 ? "same beat on every note" : "beat locked to the grid", 20, 274, 180, 12, 1);
  TX(phasemode == 0 ? "never reset" : phasemode == 1 ? "same attack every note" : "random start", 212, 274, 180, 12, 1);
  knob(14, 450, 228, "LEVEL");
  knob(79, 522, 228, "OCTAVE");
  small_caption("BEAT (the Reese throb)", 20, 304, 580);
  col(0.07, 0.075, 0.09, 1); RF(20, 322, 580, 28);
  ui_bv = 0.5 + 0.5*cos(2*$pi*beat_ph);
  col(acr, acg, acb, 0.25 + 0.6*ui_bv); RF(22, 324, 576*ui_bv, 24);
  col(0.25, 0.27, 0.32, 1); RO(20, 322, 580, 28);
  font(5); col(0.95, 0.97, 1, 1);
  sprintf(#bt, "%.2f Hz   (one throb every %.2f s)", abs(ui_beat), 1/max(abs(ui_beat), 0.001));
  TX(#bt, 20, 322, 580, 28, 5);
  font(6); col(0.5, 0.53, 0.6, 1);
  TX("Tip: Hz or Sync mode keeps the throb speed the same across a whole bassline", 20, 358, 580, 12, 1);

  // -------------------------------------------------------------- scope
  panel(620, 92, 330, 300, "SCOPE / THROB");
  draw_scope(630, 120, 310, 170);
  font(6); col(0.5, 0.53, 0.6, 1); TX("level over the last 3 s", 630, 296, 310, 12, 0);
  draw_throb(630, 312, 310, 70);

  // -------------------------------------------------------------- filter
  accent(1.0, 0.72, 0.2);
  panel(10, 400, 410, 262, "FILTER");
  dropdown(21, 110, 405, 300, 24);
  knob(22, 18, 438, "CUTOFF"); knob(23, 98, 438, "RESO"); knob(24, 178, 438, "DRIVE");
  knob(25, 258, 438, "KEY"); knob(26, 338, 438, "ENV");
  draw_filter_curve(20, 520, 390, 132);

  // -------------------------------------------------------------- sub + noise
  accent(0.55, 0.85, 0.35);
  panel(430, 400, 250, 262, "SUB + NOISE");
  knob(15, 438, 430, "SUB"); knob(18, 518, 430, "NOISE"); knob(19, 598, 430, "COLOR");
  knob(20, 438, 512, "LOW CUT");
  small_caption("SUB OCT", 518, 516, 150); segs(17, 518, 532, 150, 22);
  small_caption("SUB WAVE", 440, 590, 230); segs(16, 440, 606, 230, 22);
  font(6); col(0.5, 0.53, 0.6, 1); TX("sub: mono, no FX   low cut: Reese only", 440, 636, 230, 12, 1);

  // -------------------------------------------------------------- play + output
  accent(0.8, 0.82, 0.86);
  panel(690, 400, 260, 262, "PLAY + OUTPUT");
  knob(75, 698, 430, "GLIDE"); knob(77, 778, 430, "BEND"); knob(81, 858, 430, "OUTPUT");
  small_caption("NOTES", 700, 514, 115); segs(74, 700, 530, 115, 22);
  small_caption("GLIDE", 825, 514, 115); segs(76, 825, 530, 115, 22);
  small_caption("OVERSAMPLING", 700, 566, 115); segs(80, 700, 582, 115, 22);
  small_caption("CLIPPER", 825, 566, 115); segs(82, 825, 582, 115, 22);
  font(6); col(0.5, 0.53, 0.6, 1);
  TX("overlap notes to glide (legato)", 700, 616, 240, 12, 1);
  TX("1x = light CPU, 4x = cleanest drive", 700, 632, 240, 12, 1);
);

// ================================================================ PAGE: MODULATION
function lfo_panel(x, y, w, h, base, title) (
  panel(x, y, w, h, title);
  dropdown(base, x + 70, y + 5, w - 80, 24);
  draw_lfo(x + 10, y + 36, w - 20, 54, slider(base));
  slider(base + 1) ? knob(base + 3, x + 8, y + 100, "RATE") : knob(base + 2, x + 8, y + 100, "RATE");
  knob(base + 5, x + 80, y + 100, "FADE IN");
  small_caption("SYNC", x + 160, y + 96, w - 170); segs(base + 1, x + 160, y + 112, w - 170, 22);
  small_caption("TRIGGER", x + 160, y + 140, w - 170); segs(base + 4, x + 160, y + 156, w - 170, 22);
  font(6); col(0.5, 0.53, 0.6, 1);
  TX("route it in the mod matrix", x + 10, y + 196, w - 20, 12, 1);
  TX("BPM + Free = locked to the song", x + 10, y + 212, w - 20, 12, 1);
);
ui_page == 1 ? (
  accent(0.35, 0.65, 1.0);
  panel(10, 92, 305, 262, "AMP ENVELOPE");
  draw_env(20, 122, 285, 66, 27);
  knob(27, 18, 198, "ATTACK"); knob(28, 90, 198, "DECAY"); knob(29, 162, 198, "SUSTAIN"); knob(30, 234, 198, "RELEASE");
  small_caption("VELOCITY SENSITIVITY", 20, 290, 285);
  hbar(78, 20, 308, 285, 22);
  panel(325, 92, 305, 262, "MOD ENVELOPE");
  draw_env(335, 122, 285, 66, 31);
  knob(31, 333, 198, "ATTACK"); knob(32, 405, 198, "DECAY"); knob(33, 477, 198, "SUSTAIN"); knob(34, 549, 198, "RELEASE");
  font(6); col(0.5, 0.53, 0.6, 1);
  TX("drives the filter ENV knob and any", 335, 292, 285, 12, 1);
  TX("mod matrix slot using 'Mod Env'", 335, 308, 285, 12, 1);
  lfo_panel(640, 92, 310, 262, 35, "LFO 1");
  lfo_panel(10, 362, 305, 300, 41, "LFO 2");

  panel(325, 362, 625, 300, "MOD MATRIX");
  font(6); col(0.5, 0.53, 0.6, 1);
  TX("source  ->  destination   amount (drag; double-click = 0)", 470, 368, 470, 14, 2);
  ui_mi = 0;
  loop(6,
    ui_my_ = 400 + ui_mi*42;
    font(3); col(0.45, 0.48, 0.55, 1); sprintf(#mn, "%d", ui_mi + 1); TX(#mn, 335, ui_my_, 14, 26, 4);
    dropdown(83 + ui_mi*3, 352, ui_my_, 170, 26);
    dropdown(84 + ui_mi*3, 530, ui_my_, 190, 26);
    hbar(85 + ui_mi*3, 728, ui_my_, 212, 26);
    ui_mi += 1;
  );
);

