desc:Reese Basser - Reese bass synthesizer
tags:instrument synthesizer bass reese
//author: Reese Basser
//version: 1.1
//
// A monophonic synthesizer that only makes Reese basses, but makes them well.
// Eight generation methods (engines), tempo-lockable beating, a Reese-focused
// filter/drive section and a "mangle" rack for creative destruction.
// Needs REAPER 6.74 or newer (more than 64 parameters + slider shapes).
//
// All sliders are hidden ("-" prefix) so REAPER shows the custom @gfx UI instead of a
// 100-row slider list; they remain normal automatable parameters.

in_pin:none
out_pin:Left
out_pin:Right

// ---------------------------------------------------------------- ENGINE
slider1:eng=0<0,7,1{Dual Saw (Classic),Supersaw Unison,PWM,Phase Distortion (CZ),FM Cross-Mod,Hard Sync,Phaser (Filter Reese),Cross-Fold}>-Engine
slider2:det=30<0,150,0.1>-Detune (cents)
slider3:detmode=0<0,2,1{Cents (tracks pitch),Hz (constant beat),Tempo Sync}>-Detune Mode
slider4:beathz=2<0.05,20,0.01:log>-Beat Rate (Hz)
slider5:beatdiv=9<0,14,1{4 Bars,2 Bars,1/1,1/2,1/2T,1/4D,1/4,1/4T,1/8D,1/8,1/8T,1/16D,1/16,1/16T,1/32}>-Beat Sync
slider6:enga=0<0,100,0.1>-Engine A
slider7:engb=45<0,100,0.1>-Engine B
slider8:engc=50<0,100,0.1>-Engine C
slider9:unison=1<1,8,1>-Unison Voices
slider10:uspread=25<0,100,0.1>-Unison Spread
slider11:spread=35<0,100,0.1>-Stereo Spread
slider12:drift=15<0,100,0.1>-Analog Drift
slider13:phasemode=0<0,2,1{Free Running,Reset,Random}>-Osc Phase
slider14:osclvl=0<-24,12,0.1>-Osc Level (dB)
// ---------------------------------------------------------------- SUB / NOISE
slider15:sublvl=0<0,100,0.1>-Sub Level
slider16:subwave=0<0,3,1{Sine,Triangle,Square,Saw}>-Sub Wave
slider17:suboct=1<0,2,1{0,-1,-2}>-Sub Octave
slider18:noiselvl=0<0,100,0.1>-Noise Level
slider19:ncolor=50<0,100,0.1>-Noise Color
slider20:lowcut=0<0,500,1:sqr>-Reese Low Cut (Hz)
// ---------------------------------------------------------------- FILTER
slider21:ftype=0<0,5,1{LP 24 Ladder,LP 12,Band Pass,High Pass,Notch,Off}>-Filter Type
slider22:cutoff=650<20,20000,1:log>-Cutoff (Hz)
slider23:reso=14<0,100,0.1>-Resonance
slider24:fdrive=0<0,100,0.1>-Filter Drive
slider25:fkey=40<0,100,0.1>-Key Track
slider26:fenv=0<-100,100,0.1>-Filter Env Amount
// ---------------------------------------------------------------- ENVELOPES
slider27:aatt=4<0.5,5000,0.1:log>-Amp Attack (ms)
slider28:adec=300<1,10000,0.1:log>-Amp Decay (ms)
slider29:asus=100<0,100,0.1>-Amp Sustain
slider30:arel=120<1,10000,0.1:log>-Amp Release (ms)
slider31:matt=1<0.5,5000,0.1:log>-Mod Attack (ms)
slider32:mdec=400<1,10000,0.1:log>-Mod Decay (ms)
slider33:msus=0<0,100,0.1>-Mod Sustain
slider34:mrel=200<1,10000,0.1:log>-Mod Release (ms)
// ---------------------------------------------------------------- LFOs
slider35:l1shape=1<0,6,1{Sine,Triangle,Saw Up,Saw Down,Square,Sample & Hold,Smooth Random}>-LFO1 Shape
slider36:l1sync=1<0,1,1{Hz,Tempo}>-LFO1 Sync
slider37:l1rate=1<0.01,40,0.01:log>-LFO1 Rate (Hz)
slider38:l1div=9<0,14,1{4 Bars,2 Bars,1/1,1/2,1/2T,1/4D,1/4,1/4T,1/8D,1/8,1/8T,1/16D,1/16,1/16T,1/32}>-LFO1 Division
slider39:l1trig=0<0,1,1{Free,Retrigger}>-LFO1 Trigger
slider40:l1fade=0<0,5000,1:sqr>-LFO1 Fade In (ms)
slider41:l2shape=0<0,6,1{Sine,Triangle,Saw Up,Saw Down,Square,Sample & Hold,Smooth Random}>-LFO2 Shape
slider42:l2sync=0<0,1,1{Hz,Tempo}>-LFO2 Sync
slider43:l2rate=0.3<0.01,40,0.01:log>-LFO2 Rate (Hz)
slider44:l2div=6<0,14,1{4 Bars,2 Bars,1/1,1/2,1/2T,1/4D,1/4,1/4T,1/8D,1/8,1/8T,1/16D,1/16,1/16T,1/32}>-LFO2 Division
slider45:l2trig=0<0,1,1{Free,Retrigger}>-LFO2 Trigger
slider46:l2fade=0<0,5000,1:sqr>-LFO2 Fade In (ms)
// ---------------------------------------------------------------- DISTORTION
slider47:dtype=0<0,5,1{Tape,Tube,Hard Clip,Wavefold,Rectify,Pedal OD}>-Distortion Type
slider48:ddrive=0<0,100,0.1>-Distortion Drive
slider49:dtone=100<0,100,0.1>-Distortion Tone
slider50:dmix=100<0,100,0.1>-Distortion Mix
slider51:dpos=0<0,1,1{Post Filter,Pre Filter}>-Distortion Position
// ---------------------------------------------------------------- MOVEMENT
slider52:mvtype=0<0,3,1{Off,Notch Sweep,Phaser,Flanger}>-Movement Type
slider53:mvfreq=600<20,10000,1:log>-Movement Freq (Hz)
slider54:mvdepth=50<0,100,0.1>-Movement Depth
slider55:mvrate=6<0,14,1{4 Bars,2 Bars,1/1,1/2,1/2T,1/4D,1/4,1/4T,1/8D,1/8,1/8T,1/16D,1/16,1/16T,1/32}>-Movement Rate
slider56:mvreso=40<0,100,0.1>-Movement Resonance
slider57:mvstereo=25<0,100,0.1>-Movement Stereo
slider58:mvmix=100<0,100,0.1>-Movement Mix
// ---------------------------------------------------------------- MANGLE
slider59:vowel=0<0,100,0.1>-Formant Vowel
slider60:fmix=0<0,100,0.1>-Formant Mix
slider61:fshift=0<-1000,1000,0.1>-Freq Shift (Hz)
slider62:shmix=0<0,100,0.1>-Freq Shift Mix
slider63:ring=1<0.25,8,0.001:log>-Ring Mod Ratio
slider64:ringmix=0<0,100,0.1>-Ring Mod Mix
slider65:bits=16<1,16,0.1>-Crush Bits
slider66:downs=1<1,50,0.01:log>-Downsample
slider67:cmix=100<0,100,0.1>-Crush Mix
slider68:squash=0<0,100,0.1>-Squash (multiband)
// ---------------------------------------------------------------- STEREO
slider69:chmix=0<0,100,0.1>-Chorus Mix
slider70:chrate=0.4<0.05,5,0.01:log>-Chorus Rate (Hz)
slider71:chdepth=50<0,100,0.1>-Chorus Depth
slider72:width=100<0,200,0.1>-Width
slider73:monobass=120<0,400,1>-Mono Bass Below (Hz)
// ---------------------------------------------------------------- GLOBAL
slider74:vmode=0<0,1,1{Legato,Retrigger}>-Note Mode
slider75:glide=80<0,2000,0.1:sqr>-Glide (ms)
slider76:glidemode=0<0,1,1{Legato Only,Always}>-Glide Mode
slider77:bendr=2<0,24,1>-Pitch Bend Range
slider78:velsens=40<0,100,0.1>-Velocity Sensitivity
slider79:octave=0<-3,2,1>-Octave
slider80:quality=1<0,2,1{1x (Eco),2x,4x (Best)}>-Oversampling
slider81:volume=-6<-48,12,0.1>-Output (dB)
slider82:limiter=1<0,1,1{Off,Soft Clip}>-Output Clipper
// ---------------------------------------------------------------- MOD MATRIX
slider83:m1src=1<0,10,1{Off,LFO 1,LFO 2,Mod Env,Amp Env,Velocity,Mod Wheel,Aftertouch,Key Track,Note Random,Beat Phase}>-Mod 1 Source
slider84:m1dst=0<0,24,1{Off,Cutoff,Resonance,Detune,Pitch,Engine A,Engine B,Engine C,Filter Drive,Dist Drive,Move Freq,Move Mix,Vowel,Freq Shift,Ring Ratio,Crush,Unison Spread,Stereo Spread,Width,Volume,Pan,Sub Level,Noise Level,LFO1 Rate,LFO2 Rate}>-Mod 1 Destination
slider85:m1amt=0<-100,100,0.1>-Mod 1 Amount
slider86:m2src=3<0,10,1{Off,LFO 1,LFO 2,Mod Env,Amp Env,Velocity,Mod Wheel,Aftertouch,Key Track,Note Random,Beat Phase}>-Mod 2 Source
slider87:m2dst=0<0,24,1{Off,Cutoff,Resonance,Detune,Pitch,Engine A,Engine B,Engine C,Filter Drive,Dist Drive,Move Freq,Move Mix,Vowel,Freq Shift,Ring Ratio,Crush,Unison Spread,Stereo Spread,Width,Volume,Pan,Sub Level,Noise Level,LFO1 Rate,LFO2 Rate}>-Mod 2 Destination
slider88:m2amt=0<-100,100,0.1>-Mod 2 Amount
slider89:m3src=6<0,10,1{Off,LFO 1,LFO 2,Mod Env,Amp Env,Velocity,Mod Wheel,Aftertouch,Key Track,Note Random,Beat Phase}>-Mod 3 Source
slider90:m3dst=0<0,24,1{Off,Cutoff,Resonance,Detune,Pitch,Engine A,Engine B,Engine C,Filter Drive,Dist Drive,Move Freq,Move Mix,Vowel,Freq Shift,Ring Ratio,Crush,Unison Spread,Stereo Spread,Width,Volume,Pan,Sub Level,Noise Level,LFO1 Rate,LFO2 Rate}>-Mod 3 Destination
slider91:m3amt=0<-100,100,0.1>-Mod 3 Amount
slider92:m4src=2<0,10,1{Off,LFO 1,LFO 2,Mod Env,Amp Env,Velocity,Mod Wheel,Aftertouch,Key Track,Note Random,Beat Phase}>-Mod 4 Source
slider93:m4dst=0<0,24,1{Off,Cutoff,Resonance,Detune,Pitch,Engine A,Engine B,Engine C,Filter Drive,Dist Drive,Move Freq,Move Mix,Vowel,Freq Shift,Ring Ratio,Crush,Unison Spread,Stereo Spread,Width,Volume,Pan,Sub Level,Noise Level,LFO1 Rate,LFO2 Rate}>-Mod 4 Destination
slider94:m4amt=0<-100,100,0.1>-Mod 4 Amount
slider95:m5src=5<0,10,1{Off,LFO 1,LFO 2,Mod Env,Amp Env,Velocity,Mod Wheel,Aftertouch,Key Track,Note Random,Beat Phase}>-Mod 5 Source
slider96:m5dst=0<0,24,1{Off,Cutoff,Resonance,Detune,Pitch,Engine A,Engine B,Engine C,Filter Drive,Dist Drive,Move Freq,Move Mix,Vowel,Freq Shift,Ring Ratio,Crush,Unison Spread,Stereo Spread,Width,Volume,Pan,Sub Level,Noise Level,LFO1 Rate,LFO2 Rate}>-Mod 5 Destination
slider97:m5amt=0<-100,100,0.1>-Mod 5 Amount
slider98:m6src=10<0,10,1{Off,LFO 1,LFO 2,Mod Env,Amp Env,Velocity,Mod Wheel,Aftertouch,Key Track,Note Random,Beat Phase}>-Mod 6 Source
slider99:m6dst=0<0,24,1{Off,Cutoff,Resonance,Detune,Pitch,Engine A,Engine B,Engine C,Filter Drive,Dist Drive,Move Freq,Move Mix,Vowel,Freq Shift,Ring Ratio,Crush,Unison Spread,Stereo Spread,Width,Volume,Pan,Sub Level,Noise Level,LFO1 Rate,LFO2 Rate}>-Mod 6 Destination
slider100:m6amt=0<-100,100,0.1>-Mod 6 Amount

@init
ext_noinit = 1;

// ================================================================ memory map
MQ = 0;            // MIDI queue: 4 values per event
NOTESTK = 8200;       // held-note stack
O_PH = 9000; O_PH2 = 9064; O_FB = 9128; O_DT = 9192; O_DT2 = 9256; O_GL = 9320; O_GR = 9384;
O_DRIFT = 9448; O_DTGT = 9512; O_POSR = 9576; O_UNI = 9640; O_SLOT = 9704; O_PAN = 9768;
SRC = 10000; MODV = 10032; MSRC = 10060; MDST = 10066; MAMT = 10072; BEATS = 10080; INTV = 10100; FMR = 10110;
PHS_L = 10400; PHS_R = 10420; MPH_L = 10440; MPH_R = 10450;
HIL_L = 10500; HIL_R = 10564;
FORMT = 10700;
PMIN = 11000; PMAX = 11300; PDEF = 11600; PSHAPE = 11900;
CHB_L = 20000; CHB_R = 28192; CHB_SIZE = 8192;
FLB_L = 40000; FLB_R = 56384; FLB_SIZE = 16384;
SCOPE = 80000; SCOPE_SIZE = 4096;
THROB = 90000; THROB_SIZE = 256;
PSTORE = 100000;   // preset store (UI)
UIMEM = 120000;    // UI scratch
freembuf(200000);

// ================================================================ tables
// tempo divisions in beats (quarter notes)
BEATS[0] = 16; BEATS[1] = 8; BEATS[2] = 4; BEATS[3] = 2; BEATS[4] = 4/3; BEATS[5] = 1.5;
BEATS[6] = 1; BEATS[7] = 2/3; BEATS[8] = 0.75; BEATS[9] = 0.5; BEATS[10] = 1/3;
BEATS[11] = 0.375; BEATS[12] = 0.25; BEATS[13] = 1/6; BEATS[14] = 0.125;
// Dual Saw: osc 2 interval (semitones)
INTV[0] = -24; INTV[1] = -12; INTV[2] = -5; INTV[3] = 0; INTV[4] = 7; INTV[5] = 12; INTV[6] = 19; INTV[7] = 24;
// FM ratios
FMR[0] = 0.5; FMR[1] = 1; FMR[2] = 1.5; FMR[3] = 2; FMR[4] = 3; FMR[5] = 4;
// Formants (bass voice): f1 f2 f3 g1 g2 g3 for A E I O U
function set6(p, a, b, c, d, e, f) ( p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; );
set6(FORMT,    800, 1150, 2900, 1, 0.63, 0.12);
set6(FORMT+6,  400, 1600, 2700, 1, 0.35, 0.25);
set6(FORMT+12, 270, 2140, 2950, 1, 0.25, 0.2);
set6(FORMT+18, 450,  800, 2830, 1, 0.45, 0.1);
set6(FORMT+24, 325,  700, 2530, 1, 0.3, 0.08);
// Hilbert transformer (Olli Niemitalo) - squared allpass coefficients
HA1 = 0.6923878^2; HA2 = 0.9360654322959^2; HA3 = 0.9882295226860^2; HA4 = 0.9987488452737^2;
HB1 = 0.4021921162426^2; HB2 = 0.8561710882420^2; HB3 = 0.9722909545651^2; HB4 = 0.9952884791278^2;

// ================================================================ helpers
function clamp(x, lo, hi) ( x < lo ? lo : x > hi ? hi : x; );
function frac(x) ( x - floor(x); );
function sat(x) ( x > 3 ? 1 : x < -3 ? -1 : x*(27 + x*x)/(27 + 9*x*x); );
function db2g(d) ( exp(d*0.11512925464970228); );
// polyBLEP residual
function blep(t, dt) (
  t < dt ? ( t /= dt; t + t - t*t - 1; ) :
  t > 1 - dt ? ( t = (t - 1)/dt; t*t + t + t + 1; ) : 0;
);
function saw(ph, dt) ( ph + ph - 1 - blep(ph, dt); );
function pulse(ph, dt, w) local(p2) (
  p2 = ph - w; p2 < 0 ? p2 += 1;
  (ph < w ? 1 : -1) + blep(ph, dt) - blep(p2, dt);
);
function tri(ph) ( 4*abs(ph - 0.5) - 1; );
// saw -> square -> triangle -> sine
function wave_morph(ph, dt, m) local(a, s, q) (
  m < 0.3333 ? ( a = m*3; s = saw(ph, dt); q = pulse(ph, dt, 0.5); s + (q - s)*a; ) :
  m < 0.6667 ? ( a = (m - 0.3333)*3; q = pulse(ph, dt, 0.5); s = tri(ph); q + (s - q)*a; ) :
  ( a = (m - 0.6667)*3.0003; s = tri(ph); q = -cos(2*$pi*ph); s + (q - s)*a; );
);
// Casio CZ style phase distortion. d = DCW 0..1
function cz_wave(ph, dt, d, wt) local(dd, w, r, win) (
  wt < 0.5 ? (                                   // saw
    dd = 0.5 - 0.5*d; dd < 2*dt ? dd = 2*dt;
    w = ph < dd ? 0.5*ph/dd : 0.5 + 0.5*(ph - dd)/(1 - dd);
    -cos(2*$pi*w);
  ) : wt < 1.5 ? (                               // square
    dd = 0.25 - 0.25*d; dd < 2*dt ? dd = 2*dt;
    w = ph < dd ? 0.5*ph/dd : ph < 0.5 ? 0.5 : ph < 0.5 + dd ? 0.5 + 0.5*(ph - 0.5)/dd : 1;
    -cos(2*$pi*w);
  ) : wt < 2.5 ? (                               // pulse
    dd = 1 - 0.9*d; dd < 2*dt ? dd = 2*dt;
    w = ph < dd ? ph/dd : 1;
    -cos(2*$pi*w);
  ) : (                                          // resonant saw / triangle / trapezoid
    r = 1 + d*14;
    win = wt < 3.5 ? 1 - ph : wt < 4.5 ? (ph < 0.5 ? ph + ph : 2 - ph - ph) : (ph < 0.5 ? 1 : 2 - ph - ph);
    win*(1 - cos(2*$pi*ph*r)) - 1;
  );
);

// ---------------------------------------------------------------- envelopes
function env_trigger() instance(st) ( st = 1; );
function env_release() instance(st) ( st > 0 ? st = 4; );
function env_tick(ca, cd, s, cr) instance(st, v) (
  st == 1 ? ( v += (1.25 - v)*ca; v >= 1 ? ( v = 1; st = 2; ); ) :
  st == 2 ? ( v += (s - v)*cd; abs(v - s) < 0.0005 ? st = 3; ) :
  st == 3 ? ( v += (s - v)*0.002; ) :
  st == 4 ? ( v -= v*cr; v < 0.00002 ? ( v = 0; st = 0; ); );
  v;
);
function env_coef(ms, div) ( 1 - exp(-div/(max(ms, 0.05)*0.001*srate)); );

// ---------------------------------------------------------------- LFO
function lfo_tick(shape, rate) instance(ph, r0, r1, out, sm) (
  ph += rate*isr;
  ph >= 1 ? ( ph -= floor(ph); r0 = r1; r1 = rand(2) - 1; );
  shape == 0 ? out = sin(2*$pi*ph) :
  shape == 1 ? out = 1 - 4*abs(ph - 0.5) :
  shape == 2 ? out = ph + ph - 1 :
  shape == 3 ? out = 1 - ph - ph :
  shape == 4 ? out = ph < 0.5 ? 1 : -1 :
  shape == 5 ? out = r1 :
  out = r0 + (r1 - r0)*(0.5 - 0.5*cos($pi*ph));
  sm += (out - sm)*lfo_smooth;
  sm;
);

// ---------------------------------------------------------------- filters
// main filter coefficients (shared by both channels)
function calc_filter(fc, rq) local(g) (
  fc = clamp(fc, 10, min(20000, fs_os*0.45));
  g = tan($pi*fc*isr_os);
  f_G = g/(1 + g); f_b = 1 - f_G; f_G4 = f_G*f_G*f_G*f_G;
  f_Gb = f_G*f_b; f_G2b = f_G*f_Gb; f_G3b = f_G*f_G2b;
  f_k = 2 - 1.96*rq;
  f_a1 = 1/(1 + g*(g + f_k)); f_a2 = g*f_a1; f_a3 = g*f_a2;
  lad_k = rq*3.9; lad_comp = 1 + lad_k*0.55;
);
function filt(x) instance(s1, s2, s3, s4, ic1, ic2) local(u, v, y1, y2, y3, y4, v1, v2, v3) (
  fdrv_on ? x = sat(x*fdg)*fdg_out;
  ftype == 0 ? (
    u = (x*lad_comp - lad_k*(f_G3b*s1 + f_G2b*s2 + f_Gb*s3 + f_b*s4))/(1 + lad_k*f_G4);
    u = sat(u);
    v = (u - s1)*f_G; y1 = v + s1; s1 = y1 + v;
    v = (y1 - s2)*f_G; y2 = v + s2; s2 = y2 + v;
    v = (y2 - s3)*f_G; y3 = v + s3; s3 = y3 + v;
    v = (y3 - s4)*f_G; y4 = v + s4; s4 = y4 + v;
    y4;
  ) : (
    v3 = x - ic2; v1 = f_a1*ic1 + f_a2*v3; v2 = ic2 + f_a2*ic1 + f_a3*v3;
    ic1 = v1 + v1 - ic1; ic2 = v2 + v2 - ic2;
    ftype == 1 ? v2 : ftype == 2 ? v1*f_k : ftype == 3 ? x - f_k*v1 - v2 : x - f_k*v1;
  );
);
// generic TPT state-variable filter with its own coefficients
function svf_set(fc, k) instance(a1, a2, a3, kk) local(g) (
  g = tan($pi*clamp(fc, 5, srate*0.45)*isr);
  kk = k; a1 = 1/(1 + g*(g + k)); a2 = g*a1; a3 = g*a2;
  sv_a1 = a1; sv_a2 = a2; sv_a3 = a3; sv_k = k;
);
// copy the coefficients computed by the last svf_set()
function svf_same() instance(a1, a2, a3, kk) ( a1 = sv_a1; a2 = sv_a2; a3 = sv_a3; kk = sv_k; );
function svf(x) instance(a1, a2, a3, kk, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1*ic1 + a2*v3; v2 = ic2 + a2*ic1 + a3*v3;
  ic1 = v1 + v1 - ic1; ic2 = v2 + v2 - ic2;
  lp = v2; bp = v1; hp = x - kk*v1 - v2;
  lp;
);
// Elliptic decimation filters, biquads in transposed direct form II
// (0.1 dB ripple to 0.45 fs, >55 dB at 0.5 fs, >90 dB at 0.55 fs)
function dec2(x) instance(a1, a2, b1, b2, c1, c2, d1, d2, e1, e2) local(y) (
  y = 0.00359934096805*x + a1; a1 = 0.00670805334677*x + 1.06037998983*y + a2; a2 = 0.00359934096805*x - 0.330198964653*y; x = y;
  y = x + b1; b1 = 1.15209572367*x + 0.815582447302*y + b2; b2 = x - 0.505804226959*y; x = y;
  y = x + c1; c1 = 0.561428581129*x + 0.54157047243*y + c2; c2 = x - 0.707942656721*y; x = y;
  y = x + d1; d1 = 0.251560853945*x + 0.36094563724*y + d2; d2 = x - 0.856182168854*y; x = y;
  y = x + e1; e1 = 0.127038420503*x + 0.282178673178*y + e2; e2 = x - 0.956958266697*y;
  y;
);
function dec4(x) instance(a1, a2, b1, b2, c1, c2, d1, d2, e1, e2, f1, f2) local(y) (
  y = 0.000235376991335*x + a1; a1 = 0.000064248965911*x + 0.783153903404*y + a2; a2 = 0.000235376991335*x; x = y;
  y = x + b1; b1 = x + 1.55323904484*y + b2; b2 = -0.660503537709*y; x = y;
  y = x + c1; c1 = -0.828481734043*x + 1.52543698655*y + c2; c2 = x - 0.763768102268*y; x = y;
  y = x + d1; d1 = -1.19305052953*x + 1.50161623449*y + d2; d2 = x - 0.86247415468*y; x = y;
  y = x + e1; e1 = -1.32755047952*x + 1.49134289416*y + e2; e2 = x - 0.932542516606*y; x = y;
  y = x + f1; f1 = -1.37496302208*x + 1.4982799417*y + f2; f2 = x - 0.979991718034*y;
  y;
);
function dec_reset() instance(a1, a2, b1, b2, c1, c2, d1, d2, e1, e2, f1, f2) (
  a1 = a2 = b1 = b2 = c1 = c2 = d1 = d2 = e1 = e2 = f1 = f2 = 0;
);
function filt_reset() instance(s1, s2, s3, s4, ic1, ic2) ( s1 = s2 = s3 = s4 = ic1 = ic2 = 0; );
function dist_reset() instance(hp, lp) ( hp = lp = 0; );
// clear the voice signal path once the amp envelope has finished, so the next
// note starts from silence instead of stale filter states
function voice_reset() (
  fl.filt_reset(); fr.filt_reset(); dsl.dist_reset(); dsr.dist_reset();
  decl.dec_reset(); decr.dec_reset();
  memset(PHS_L, 0, 40);
  dcx_l = dcy_l = dcx_r = dcy_r = 0;
);

// ---------------------------------------------------------------- distortion
function dist(x) instance(hp, lp) local(y, v) (
  v = x*d_gain;
  dtype == 0 ? y = sat(v) :
  dtype == 1 ? y = (sat(v*0.8 + 0.5) - d_tubeoff)*1.2 :
  dtype == 2 ? y = clamp(v, -1, 1) :
  dtype == 3 ? y = sin(v*1.5707963) :
  dtype == 4 ? y = abs(sat(v))*2 - 1 :
  (
    hp += (v - hp)*d_pedal_c;
    v += (v - hp)*2;
    y = v > 0 ? sat(v*1.4) : sat(v)*0.8;
  );
  d_tone_on ? ( lp += (y - lp)*d_tone_c; y = lp; );
  x + (y - x)*d_mix;
);

// ---------------------------------------------------------------- phaser (engine 6)
function eng_phaser(x, st, a) local(y, v, i) (
  y = x + st[0]*ph_fb;
  i = 1;
  loop(ph_stages, v = a*y + st[i]; st[i] = y - a*v; y = v; i += 1; );
  st[0] = y;
  0.5*(x + y);
);

// ---------------------------------------------------------------- Hilbert / freq shifter
function ap2(x, c, st) local(y) (
  y = c*(x + st[3]) - st[1];
  st[1] = st[0]; st[0] = x; st[3] = st[2]; st[2] = y;
  y;
);
// returns real part, imaginary part left in hil_im
function hilbert(x, st) local(a, b) (
  a = ap2(ap2(ap2(ap2(x, HA1, st), HA2, st+4), HA3, st+8), HA4, st+12);
  b = ap2(ap2(ap2(ap2(x, HB1, st+16), HB2, st+20), HB3, st+24), HB4, st+28);
  hil_im = b;
  b = st[32]; st[32] = a;
  b;
);

// ---------------------------------------------------------------- delay line read
function dread(buf, size, pos, d) local(rp, i, f) (
  rp = pos - d; rp < 0 ? rp += size;
  i = floor(rp); f = rp - i;
  buf[i] + (buf[i + 1 < size ? i + 1 : 0] - buf[i])*f;
);

// ================================================================ voice setup
function setup_voices() local(k, s, u, ns, uu, pos, pan) (
  eng == 1 ? ( ns = 3 + floor(enga*0.13 + 0.5); uu = 1; ) :
  eng == 6 ? ( ns = 1; uu = unison; ) :
  ( ns = 2; uu = unison; );
  nslots = ns; nuni = uu; nosc = ns*uu;
  k = 0;
  s = 0;
  loop(ns,
    u = 0;
    loop(uu,
      pos = ns == 1 ? 0 : -1 + 2*s/(ns - 1);
      O_POSR[k] = pos;
      O_UNI[k] = uu == 1 ? 0 : -1 + 2*u/(uu - 1);
      O_SLOT[k] = s;
      eng == 1 ? pan = abs(pos)*((s & 1) ? 1 : -1) :
      ns == 1 ? pan = O_UNI[k] :
      pan = pos*0.7 + O_UNI[k]*0.3;
      O_PAN[k] = pan;
      O_DRIFT[k] = 0; O_DTGT[k] = rand(2) - 1;
      k += 1; u += 1;
    );
    s += 1;
  );
  last_spread = -1;
);
function update_pans(sp) local(k, a) (
  k = 0;
  loop(nosc,
    a = (clamp(O_PAN[k]*sp, -1, 1) + 1)*0.25*$pi;
    O_GL[k] = cos(a)*1.41421356; O_GR[k] = sin(a)*1.41421356;
    k += 1;
  );
);
function reset_phases(mode) local(k) (
  k = 0;
  loop(nosc,
    mode == 1 ? ( O_PH[k] = 0; O_PH2[k] = 0; ) : ( O_PH[k] = rand(1); O_PH2[k] = rand(1); );
    O_FB[k] = 0;
    k += 1;
  );
);
// lock the pair's relative phase to the song position (tempo-synced beating)
function lock_beat_phase() local(k, rel) (
  rel = frac(beat_position_now/BEATS[beatdiv]);
  k = 0;
  loop(nosc,
    O_SLOT[k] == 1 ? O_PH[k] = frac(O_PH[k - nuni] + rel);
    k += 1;
  );
  beat_ph = rel;
);

// ================================================================ MIDI / notes
function stack_remove(n) local(i, j) (
  i = 0; j = 0;
  loop(nstk,
    NOTESTK[i] != n ? ( NOTESTK[j] = NOTESTK[i]; j += 1; );
    i += 1;
  );
  nstk = j;
);
function start_note(n, retrig) (
  tgt_pitch = n;
  retrig ? (
    aenv_o.env_trigger(); menv_o.env_trigger();
    note_rnd = rand(2) - 1;
    note_time = 0;
    l1trig ? ( lfo1.ph = 0; lfo1.sm = 0; );
    l2trig ? ( lfo2.ph = 0; lfo2.sm = 0; );
    phasemode > 0 ? reset_phases(phasemode);
    aenv_o.v < 0.001 ? sub_ph = 0;
    detmode == 2 ? lock_beat_phase();
  );
);
function note_on(n, v) local(was_held) (
  was_held = nstk > 0 || (sustain_ped && gate);
  stack_remove(n);
  nstk < 64 ? ( NOTESTK[nstk] = n; nstk += 1; );
  vel = v/127;
  do_glide = glide > 0 && (glidemode == 1 ? has_played : was_held);
  !do_glide ? cur_pitch = n;
  start_note(n, !(was_held && vmode == 0));
  gate = 1; has_played = 1;
);
function release_all() (
  gate = 0;
  aenv_o.env_release(); menv_o.env_release();
);
function note_off(n) (
  stack_remove(n);
  nstk > 0 ? (
    NOTESTK[nstk - 1] != tgt_pitch ? (
      do_glide = glide > 0;
      !do_glide ? cur_pitch = NOTESTK[nstk - 1];
      start_note(NOTESTK[nstk - 1], vmode == 1);
    );
  ) : (
    !sustain_ped ? release_all();
  );
);
function all_notes_off() ( nstk = 0; release_all(); );
function handle_midi(s, d1, d2) local(st) (
  st = s & 0xF0;
  st == 0x90 && d2 > 0 ? note_on(d1, d2) :
  st == 0x80 || st == 0x90 ? note_off(d1) :
  st == 0xE0 ? bend_v = ((d2*128 + d1) - 8192)/8192 :
  st == 0xB0 ? (
    d1 == 1 ? modwheel = d2/127 :
    d1 == 64 ? ( sustain_ped = d2 >= 64; !sustain_ped && nstk == 0 && gate ? release_all(); ) :
    d1 == 123 || d1 == 120 ? all_notes_off();
  ) :
  st == 0xD0 ? aftertouch = d1/127 :
  st == 0xA0 ? aftertouch = d2/127;
);

// ================================================================ derived parameters
function update_params() (
  // srate may not be valid in @init (ext_noinit), so everything rate-dependent lives here
  isr = 1/srate; last_srate = srate;
  lfo_smooth = 1 - exp(-1/(0.0015*srate));
  smc = 1 - exp(-1/(0.012*srate));
  vel_c = 1 - exp(-1/(0.004*srate));
  dc_r = 1 - 2*$pi*8/srate;
  os = quality == 0 ? 1 : quality == 1 ? 2 : 4;
  fs_os = srate*os; isr_os = 1/fs_os;
  os != last_os ? ( decl.dec_reset(); decr.dec_reset(); last_os = os; );
  // voice layout
  ssv = eng == 1 ? floor(enga*0.13 + 0.5) : 0;
  (eng != prev_eng || unison != prev_uni || ssv != prev_ssv) ? (
    setup_voices(); prev_eng = eng; prev_uni = unison; prev_ssv = ssv;
  );
  // envelopes
  a_ca = env_coef(aatt, 1.6094); a_cd = env_coef(adec, 4.6); a_cr = env_coef(arel, 4.6);
  m_ca = env_coef(matt, 1.6094); m_cd = env_coef(mdec, 4.6); m_cr = env_coef(mrel, 4.6);
  asus_n = asus/100; msus_n = msus/100;
  gcoef = glide > 0 ? 1 - exp(-3/(glide*0.001*srate)) : 1;
  osc_gain = db2g(osclvl);
  // distortion constants
  d_tubeoff = sat(0.5);
  d_pedal_c = 1 - exp(-2*$pi*720*isr_os);
  d_tone_on = dtone < 99.5;
  d_tone_c = 1 - exp(-2*$pi*(400*2^(dtone*0.0564))*isr_os);
  d_mix = dmix/100;
  // noise color
  ncolor < 50 ? ( n_lpmode = 1; n_c = 1 - exp(-2*$pi*(150*2^(ncolor/50*7))*isr_os); ) :
                ( n_lpmode = 0; n_c = 1 - exp(-2*$pi*(20*2^((ncolor - 50)/50*9))*isr_os); );
  // output / misc
  vol_target = db2g(volume);
  lowcut > 0 ? ( lc1.svf_set(lowcut, 1.41421356); lc2.svf_same(); lc3.svf_same(); lc4.svf_same(); );
  monobass > 0 ? ( mb1.svf_set(monobass, 1.41421356); mb2.svf_same(); mb3.svf_same(); mb4.svf_same(); );
  // squash crossovers
  sq_l1.svf_set(150, 1.41421356); sq_l2.svf_same(); sq_r1.svf_same(); sq_r2.svf_same();
  sq_m1.svf_set(2500, 1.41421356); sq_m2.svf_same(); sq_m3.svf_same(); sq_m4.svf_same();
  sq_att = 1 - exp(-1/(0.002*srate)); sq_rel = 1 - exp(-1/(0.08*srate));
  // active modulation slots
  n_mod = 0; mi = 0;
  loop(6,
    slider(83 + mi*3) > 0 && slider(84 + mi*3) > 0 && slider(85 + mi*3) != 0 ? (
      MSRC[n_mod] = slider(83 + mi*3); MDST[n_mod] = slider(84 + mi*3); MAMT[n_mod] = slider(85 + mi*3)*0.01;
      n_mod += 1;
    );
    mi += 1;
  );
  memset(MODV, 0, 26);
  lcut_target = log(cutoff)*1.4426950408889634;
  mvf_target = log(mvfreq)*1.4426950408889634;
  // ring mod / crush
  crush_on = (bits < 15.95 || downs > 1.01) && cmix > 0;
  drift_k = 1 - exp(-1/(0.3*srate));
);

// ================================================================ state
nstk = 0; gate = 0; vel = 0.8; cur_pitch = tgt_pitch = 36; has_played = 0;
modwheel = 0; aftertouch = 0; bend_v = 0; sustain_ped = 0;
velg = 1;
sm_lcut = log(cutoff)/log(2); sm_det = det; sm_a = enga; sm_b = engb; sm_c = engc;
sm_vol = db2g(volume); sm_mvf = log(mvfreq)/log(2); sm_vowel = vowel; sm_shift = fshift;
sm_beathz = beathz;
drift_ctr = 0;
scope_pos = 0; throb_pos = 0; throb_acc = 0; throb_n = 0;
prev_eng = -1; prev_uni = -1; prev_ssv = -1;
last_os = -1;
beat_position_now = 0;

// ================================================================ UI: parameter table
// shape: 0 linear, 1 log, 2 square, 3 bipolar cubic
// unit: 0 plain, 1 Hz, 2 ms, 3 %, 4 cents, 5 dB, 6 integer, 7 ratio, 8 semitones, 9 bipolar %, 10 enum, 11 octave
PUNIT = 12200; PNAME = 12500; PENUM = 12800; PSTEP = 13100;
function pm(i, mn, mx, def, shape, unit, name) (
  PMIN[i] = mn; PMAX[i] = mx; PDEF[i] = def; PSHAPE[i] = shape; PUNIT[i] = unit; PNAME[i] = name;
  PENUM[i] = 0; PSTEP[i] = unit == 10 || unit == 6 || unit == 11 ? 1 : 0;
);
function pe(i, def, items, name) ( pm(i, 0, 100, def, 0, 10, name); PENUM[i] = items; PSTEP[i] = 1; );
DIVS = "4 Bars|2 Bars|1/1|1/2|1/2T|1/4D|1/4|1/4T|1/8D|1/8|1/8T|1/16D|1/16|1/16T|1/32";
MODSRC = "Off|LFO 1|LFO 2|Mod Env|Amp Env|Velocity|Mod Wheel|Aftertouch|Key Track|Note Random|Beat Phase";
MODDST = "Off|Cutoff|Resonance|Detune|Pitch|Engine A|Engine B|Engine C|Filter Drive|Dist Drive|Move Freq|Move Mix|Vowel|Freq Shift|Ring Ratio|Crush|Unison Spread|Stereo Spread|Width|Volume|Pan|Sub Level|Noise Level|LFO1 Rate|LFO2 Rate";
LFOSHAPES = "Sine|Triangle|Saw Up|Saw Down|Square|Sample & Hold|Smooth Random";
ENGINES = "Dual Saw (Classic)|Supersaw Unison|PWM|Phase Distortion (CZ)|FM Cross-Mod|Hard Sync|Phaser (Filter Reese)|Cross-Fold";
pe(1, 0, ENGINES, "Engine");
pm(2, 0, 150, 30, 2, 4, "Detune");
pe(3, 0, "Cents|Hz|Sync", "Detune Mode");
pm(4, 0.05, 20, 2, 1, 1, "Beat Rate");
pe(5, 9, DIVS, "Beat Sync");
pm(6, 0, 100, 0, 0, 3, "Engine A"); pm(7, 0, 100, 45, 0, 3, "Engine B"); pm(8, 0, 100, 50, 0, 3, "Engine C");
pm(9, 1, 8, 1, 0, 6, "Unison Voices");
pm(10, 0, 100, 25, 0, 3, "Unison Spread");
pm(11, 0, 100, 35, 0, 3, "Stereo Spread");
pm(12, 0, 100, 15, 0, 3, "Analog Drift");
pe(13, 0, "Free|Reset|Random", "Osc Phase");
pm(14, -24, 12, 0, 0, 5, "Osc Level");
pm(15, 0, 100, 0, 0, 3, "Sub Level");
pe(16, 0, "Sine|Triangle|Square|Saw", "Sub Wave");
pe(17, 1, "0|-1|-2", "Sub Octave");
pm(18, 0, 100, 0, 0, 3, "Noise Level");
pm(19, 0, 100, 50, 0, 3, "Noise Color");
pm(20, 0, 500, 0, 2, 1, "Reese Low Cut");
pe(21, 0, "LP 24 Ladder|LP 12|Band Pass|High Pass|Notch|Off", "Filter Type");
pm(22, 20, 20000, 650, 1, 1, "Cutoff");
pm(23, 0, 100, 14, 0, 3, "Resonance");
pm(24, 0, 100, 0, 0, 3, "Filter Drive");
pm(25, 0, 100, 40, 0, 3, "Key Track");
pm(26, -100, 100, 0, 0, 9, "Filter Env Amount");
pm(27, 0.5, 5000, 4, 1, 2, "Amp Attack"); pm(28, 1, 10000, 300, 1, 2, "Amp Decay");
pm(29, 0, 100, 100, 0, 3, "Amp Sustain"); pm(30, 1, 10000, 120, 1, 2, "Amp Release");
pm(31, 0.5, 5000, 1, 1, 2, "Mod Attack"); pm(32, 1, 10000, 400, 1, 2, "Mod Decay");
pm(33, 0, 100, 0, 0, 3, "Mod Sustain"); pm(34, 1, 10000, 200, 1, 2, "Mod Release");
pe(35, 1, LFOSHAPES, "LFO1 Shape"); pe(36, 1, "Hz|BPM", "LFO1 Sync");
pm(37, 0.01, 40, 1, 1, 1, "LFO1 Rate"); pe(38, 9, DIVS, "LFO1 Division");
pe(39, 0, "Free|Retrig", "LFO1 Trigger"); pm(40, 0, 5000, 0, 2, 2, "LFO1 Fade In");
pe(41, 0, LFOSHAPES, "LFO2 Shape"); pe(42, 0, "Hz|BPM", "LFO2 Sync");
pm(43, 0.01, 40, 0.3, 1, 1, "LFO2 Rate"); pe(44, 6, DIVS, "LFO2 Division");
pe(45, 0, "Free|Retrig", "LFO2 Trigger"); pm(46, 0, 5000, 0, 2, 2, "LFO2 Fade In");
pe(47, 0, "Tape|Tube|Hard Clip|Wavefold|Rectify|Pedal OD", "Distortion Type");
pm(48, 0, 100, 0, 0, 3, "Distortion Drive"); pm(49, 0, 100, 100, 0, 3, "Distortion Tone");
pm(50, 0, 100, 100, 0, 3, "Distortion Mix"); pe(51, 0, "Post|Pre", "Distortion Position");
pe(52, 0, "Off|Notch Sweep|Phaser|Flanger", "Movement Type");
pm(53, 20, 10000, 600, 1, 1, "Movement Freq"); pm(54, 0, 100, 50, 0, 3, "Movement Depth");
pe(55, 6, DIVS, "Movement Rate"); pm(56, 0, 100, 40, 0, 3, "Movement Resonance");
pm(57, 0, 100, 25, 0, 3, "Movement Stereo"); pm(58, 0, 100, 100, 0, 3, "Movement Mix");
pm(59, 0, 100, 0, 0, 3, "Formant Vowel"); pm(60, 0, 100, 0, 0, 3, "Formant Mix");
pm(61, -1000, 1000, 0, 3, 1, "Freq Shift"); pm(62, 0, 100, 0, 0, 3, "Freq Shift Mix");
pm(63, 0.25, 8, 1, 1, 7, "Ring Mod Ratio"); pm(64, 0, 100, 0, 0, 3, "Ring Mod Mix");
pm(65, 1, 16, 16, 0, 0, "Crush Bits"); pm(66, 1, 50, 1, 1, 7, "Downsample");
pm(67, 0, 100, 100, 0, 3, "Crush Mix"); pm(68, 0, 100, 0, 0, 3, "Squash");
pm(69, 0, 100, 0, 0, 3, "Chorus Mix"); pm(70, 0.05, 5, 0.4, 1, 1, "Chorus Rate");
pm(71, 0, 100, 50, 0, 3, "Chorus Depth"); pm(72, 0, 200, 100, 0, 3, "Width");
pm(73, 0, 400, 120, 0, 1, "Mono Bass Below");
pe(74, 0, "Legato|Retrig", "Note Mode"); pm(75, 0, 2000, 80, 2, 2, "Glide");
pe(76, 0, "Legato|Always", "Glide Mode"); pm(77, 0, 24, 2, 0, 8, "Pitch Bend Range");
pm(78, 0, 100, 40, 0, 3, "Velocity Sensitivity"); pm(79, -3, 2, 0, 0, 11, "Octave");
pe(80, 1, "1x|2x|4x", "Oversampling"); pm(81, -48, 12, -6, 0, 5, "Output");
pe(82, 1, "Off|On", "Output Clipper");
mi = 0;
loop(6,
  pe(83 + mi*3, 0, MODSRC, "Mod Source"); pe(84 + mi*3, 0, MODDST, "Mod Destination");
  pm(85 + mi*3, -100, 100, 0, 0, 9, "Mod Amount");
  mi += 1;
);
PDEF[83] = 1; PDEF[86] = 3; PDEF[89] = 6; PDEF[92] = 2; PDEF[95] = 5; PDEF[98] = 10;
// enum sliders: real range is 0..count-1
function enum_count(list) local(i, n, c) (
  n = 1; i = 0;
  while ((c = str_getchar(list, i)) > 0) ( c == 124 ? n += 1; i += 1; );
  n;
);
mi = 1;
loop(100,
  PENUM[mi] ? PMAX[mi] = enum_count(PENUM[mi]) - 1;
  mi += 1;
);

// engine specific texts
ENGDESC = 12400; ENGLBL = 12420;
ENGDESC[0] = "Two detuned oscillators - the classic Reese (Saunderson, jungle, DnB)";
ENGDESC[1] = "Stacked unison saws with a JP-style spread - the modern wide Reese";
ENGDESC[2] = "Pulse width swept at the beat rate - PWM Reese, two phased pulses";
ENGDESC[3] = "Casio CZ phase distortion, lines 1 + 1' detuned - the original '88 tone";
ENGDESC[4] = "Detuned carriers phase-modulated by a sine - evolving FM Reese";
ENGDESC[5] = "Detuned hard-synced pairs - aggressive, vocal neuro growl";
ENGDESC[6] = "One saw through a key-tracked phaser swept at the beat rate";
ENGDESC[7] = "Sine wavefolder audio-rate modulated by its detuned twin (Noise Eng. style)";
function el(e, a, b, c) ( ENGLBL[e*3] = a; ENGLBL[e*3 + 1] = b; ENGLBL[e*3 + 2] = c; );
el(0, "WAVE 2", "PITCH 2", "BALANCE");
el(1, "VOICES", "CURVE", "SIDES");
el(2, "PWM", "WIDTH", "OSC 2");
el(3, "DCW", "WAVE", "LINE 1'");
el(4, "INDEX", "RATIO", "FEEDBACK");
el(5, "SYNC", "SLAVE", "MASTER");
el(6, "DEPTH", "FEEDBACK", "STAGES");
el(7, "FOLD", "X-MOD", "SYMMETRY");
CZWAVES = "Saw|Square|Pulse|Reso Saw|Reso Tri|Reso Trap";
// sensible starting points for engine A / B / C when an engine is picked in the UI
ENGDEF = 12460;
function ed(e, a, b, c) ( ENGDEF[e*3] = a; ENGDEF[e*3 + 1] = b; ENGDEF[e*3 + 2] = c; );
ed(0, 0, 45, 50); ed(1, 30, 30, 70); ed(2, 60, 20, 70); ed(3, 55, 0, 100);
ed(4, 40, 20, 25); ed(5, 35, 0, 25); ed(6, 60, 50, 60); ed(7, 40, 50, 50);

// ================================================================ UI: helpers
function norm_of(i, v) local(mn, mx, sh) (
  mn = PMIN[i]; mx = PMAX[i]; sh = PSHAPE[i];
  sh == 1 ? log(max(v, mn)/mn)/log(mx/mn) :
  sh == 2 ? sqrt(max(0, (v - mn)/(mx - mn))) :
  sh == 3 ? ( v = (v - mn)/(mx - mn)*2 - 1; 0.5 + 0.5*(v < 0 ? -1 : 1)*abs(v)^(1/3); ) :
  (v - mn)/(mx - mn);
);
function val_of(i, n) local(mn, mx, sh, v) (
  mn = PMIN[i]; mx = PMAX[i]; sh = PSHAPE[i];
  n = clamp(n, 0, 1);
  v = sh == 1 ? mn*(mx/mn)^n :
      sh == 2 ? mn + (mx - mn)*n*n :
      sh == 3 ? ( n = n*2 - 1; mn + (mx - mn)*(0.5 + 0.5*n*n*n); ) :
      mn + (mx - mn)*n;
  PSTEP[i] ? v = floor(v + 0.5);
  v;
);
// notify REAPER about a changed parameter by passing the slider variable itself
function notify(i) (
  i == 1 ? sliderchange(eng) :
  i == 2 ? sliderchange(det) :
  i == 3 ? sliderchange(detmode) :
  i == 4 ? sliderchange(beathz) :
  i == 5 ? sliderchange(beatdiv) :
  i == 6 ? sliderchange(enga) :
  i == 7 ? sliderchange(engb) :
  i == 8 ? sliderchange(engc) :
  i == 9 ? sliderchange(unison) :
  i == 10 ? sliderchange(uspread) :
  i == 11 ? sliderchange(spread) :
  i == 12 ? sliderchange(drift) :
  i == 13 ? sliderchange(phasemode) :
  i == 14 ? sliderchange(osclvl) :
  i == 15 ? sliderchange(sublvl) :
  i == 16 ? sliderchange(subwave) :
  i == 17 ? sliderchange(suboct) :
  i == 18 ? sliderchange(noiselvl) :
  i == 19 ? sliderchange(ncolor) :
  i == 20 ? sliderchange(lowcut) :
  i == 21 ? sliderchange(ftype) :
  i == 22 ? sliderchange(cutoff) :
  i == 23 ? sliderchange(reso) :
  i == 24 ? sliderchange(fdrive) :
  i == 25 ? sliderchange(fkey) :
  i == 26 ? sliderchange(fenv) :
  i == 27 ? sliderchange(aatt) :
  i == 28 ? sliderchange(adec) :
  i == 29 ? sliderchange(asus) :
  i == 30 ? sliderchange(arel) :
  i == 31 ? sliderchange(matt) :
  i == 32 ? sliderchange(mdec) :
  i == 33 ? sliderchange(msus) :
  i == 34 ? sliderchange(mrel) :
  i == 35 ? sliderchange(l1shape) :
  i == 36 ? sliderchange(l1sync) :
  i == 37 ? sliderchange(l1rate) :
  i == 38 ? sliderchange(l1div) :
  i == 39 ? sliderchange(l1trig) :
  i == 40 ? sliderchange(l1fade) :
  i == 41 ? sliderchange(l2shape) :
  i == 42 ? sliderchange(l2sync) :
  i == 43 ? sliderchange(l2rate) :
  i == 44 ? sliderchange(l2div) :
  i == 45 ? sliderchange(l2trig) :
  i == 46 ? sliderchange(l2fade) :
  i == 47 ? sliderchange(dtype) :
  i == 48 ? sliderchange(ddrive) :
  i == 49 ? sliderchange(dtone) :
  i == 50 ? sliderchange(dmix) :
  i == 51 ? sliderchange(dpos) :
