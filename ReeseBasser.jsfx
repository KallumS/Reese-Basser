  TX("inharmonic / barber-pole", 158, 494, 136, 12, 1);
  TX("in tune with the note", 296, 494, 136, 12, 1);
  TX("bits + sample rate", 434, 494, 204, 12, 1);
  TX("OTT-ish", 640, 494, 66, 12, 1);
  small_caption("SIGNAL FLOW", 20, 540, 680);
  font(5); col(0.62, 0.65, 0.72, 1);
  TX("voice  >  formant  >  ring  >  shift  >  crush  >  movement  >  squash  >  stereo  >  + sub", 20, 562, 680, 16, 1);
  font(6); col(0.5, 0.53, 0.6, 1);
