  i == 39 ? slider_automate(l1trig, done) :
  i == 40 ? slider_automate(l1fade, done) :
  i == 41 ? slider_automate(l2shape, done) :
  i == 42 ? slider_automate(l2sync, done) :
  i == 43 ? slider_automate(l2rate, done) :
  i == 44 ? slider_automate(l2div, done) :
  i == 45 ? slider_automate(l2trig, done) :
  i == 46 ? slider_automate(l2fade, done) :
  i == 47 ? slider_automate(dtype, done) :
  i == 48 ? slider_automate(ddrive, done) :
  i == 49 ? slider_automate(dtone, done) :
  i == 50 ? slider_automate(dmix, done) :
  i == 51 ? slider_automate(dpos, done) :
  i == 52 ? slider_automate(mvtype, done) :
  i == 53 ? slider_automate(mvfreq, done) :
  i == 54 ? slider_automate(mvdepth, done) :
  i == 55 ? slider_automate(mvrate, done) :
  i == 56 ? slider_automate(mvreso, done) :
  i == 57 ? slider_automate(mvstereo, done) :
  i == 58 ? slider_automate(mvmix, done) :
  i == 59 ? slider_automate(vowel, done) :
  i == 60 ? slider_automate(fmix, done) :
  i == 61 ? slider_automate(fshift, done) :
